{% liquid
  assign block_settings = block.settings
%}

<div 
  class="bullet-points bullet-points--{{ block.id }} spacing-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.block_background != 'transparent' %}
      background-color: {{ block_settings.block_background }};
      border-radius: {{ block_settings.block_border_radius }}px;
    {% endif %}
    {% if block_settings.border != 'none' %}
      border-width: {{ block_settings.border_width }}px;
      border-style: {{ block_settings.border }};
      {% if block_settings.border_color_mode == 'default' %}
        border-color: rgb(var(--color-border-rgb) / {{ block_settings.border_opacity | divided_by: 100.0 }});
      {% else %}
        border-color: {{ block_settings.border_color }};
      {% endif %}
      {% if block_settings.block_background == 'transparent' %}
        border-radius: {{ block_settings.block_border_radius }}px;
      {% endif %}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% if block_settings.title != blank %}
    <p 
      class="bullet-points__title"
      style="
        font-size: {{ block_settings.title_size }}px;
        color: {{ block_settings.title_color }};
        margin: 0 0 0.5rem 0;
        font-weight: 600;
      "
    >
      {{ block_settings.title }}
    </p>
  {% endif %}
  
  <ul 
    class="bullet-points__list"
    style="
      list-style: none;
      padding: 0;
      margin: 0;
    "
  >
    {% for i in (1..5) %}
      {% assign point_key = 'point_' | append: i %}
      {% assign point_text = block_settings[point_key] %}
      {% assign icon_key = 'icon_' | append: i %}
      {% assign point_icon = block_settings[icon_key] %}
      {% assign icon_color_key = 'icon_' | append: i | append: '_color' %}
      {% assign point_icon_color = block_settings[icon_color_key] %}
      {% assign icon_background_key = 'icon_' | append: i | append: '_background' %}
      {% assign point_icon_background = block_settings[icon_background_key] %}
      {% assign icon_image_key = 'icon_' | append: i | append: '_image' %}
      {% assign point_icon_image = block_settings[icon_image_key] %}
      {% assign image_size = block_settings.icon_size | times: 2 %}
      
      {% if point_text != blank %}
        <li 
          class="bullet-points__item"
          style="
            display: flex;
            {% if block_settings.icon_alignment == 'top' %}
              align-items: flex-start;
            {% else %}
              align-items: center;
            {% endif %}
            gap: var(--gap-xs);
            margin-bottom: {{ block_settings.spacing }}px;
            font-size: {{ block_settings.text_size }}px;
            color: {{ block_settings.text_color }};
            line-height: 1.5;
          "
        >
          <span 
            class="bullet-points__icon"
            style="
              flex-shrink: 0;
              width: {{ block_settings.icon_size }}px;
              height: {{ block_settings.icon_size }}px;
              {% if point_icon_image == blank %}
                background-color: {{ point_icon_background | default: block_settings.icon_background }};
                color: {{ point_icon_color | default: block_settings.icon_color }};
                {% if block_settings.icon_style == 'circle' %}
                  border-radius: 50%;
                {% elsif block_settings.icon_style == 'square' %}
                  border-radius: 4px;
                {% else %}
                  border-radius: 0;
                  background-color: transparent;
                {% endif %}
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: {{ block_settings.icon_size | divided_by: 2 }}px;
                font-weight: bold;
              {% else %}
                background-color: transparent;
                border-radius: 0;
                display: flex;
                align-items: center;
                justify-content: center;
              {% endif %}
              margin-top: 0.125rem;
            "
          >
            {% if point_icon_image != blank %}
              <img 
                src="{{ point_icon_image | image_url: width: image_size }}"
                alt="Icon {{ i }}"
                width="{{ block_settings.icon_size }}"
                height="{{ block_settings.icon_size }}"
                style="
                  width: {{ block_settings.icon_size }}px;
                  height: {{ block_settings.icon_size }}px;
                  object-fit: contain;
                  {% if block_settings.icon_style == 'circle' %}
                    border-radius: 50%;
                  {% elsif block_settings.icon_style == 'square' %}
                    border-radius: 4px;
                  {% endif %}
                "
              >
            {% else %}
              {% if point_icon == 'check' %}
                ✓
              {% elsif point_icon == 'star' %}
                ★
              {% elsif point_icon == 'arrow' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="{{ block_settings.icon_size }}" height="{{ block_settings.icon_size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                  <path d="M6 12H18M18 12L13 7M18 12L13 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% elsif point_icon == 'bullet' %}
                •
              {% elsif point_icon == 'cross' %}
                ✕
              {% else %}
                {{ i }}
              {% endif %}
            {% endif %}
          </span>
          
          <span class="bullet-points__text">
            {{ point_text }}
          </span>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .bullet-points {
    position: relative;
  }

  .bullet-points__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .bullet-points__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  
  .bullet-points__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .bullet-points__icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .bullet-points__icon svg {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }
  
  .bullet-points__text {
    flex: 1;
  }
  
  /* Mobile responsive */
  @media screen and (max-width: 749px) {
    .bullet-points__item {
      gap: 0.5rem;
    }
  }
{% endstylesheet %}

