  "
  {{ block.shopify_attributes }}
>
  {% if block_settings.title != blank %}
    <div class="quantity-breaks__title">
      <span class="quantity-breaks__heading">{{ block_settings.title }}</span>
    </div>
  {% endif %}
  
  
  <div 
    class="quantity-breaks__container"
  {% if block_settings.ancher_id != blank %}id="{{ block_settings.ancher_id }}"{% endif %}
    data-columns-desktop="{{ block_settings.columns_per_row_desktop | default: 3 }}"
    data-columns-mobile="{{ block_settings.columns_per_row_mobile | default: 1 }}"
    data-two-column-layout-desktop="{{ block_settings.two_column_layout_desktop | default: 'horizontal' }}"
    data-two-column-layout-mobile="{{ block_settings.two_column_layout_mobile | default: 'horizontal' }}"
  >
    <!-- Option 1 -->
    {% if option_1_enabled == true and option_1_quantity > 0 %}
    {% assign show_picker_1 = false %}
    {% if show_variant_picker and product_has_variants and option_1_quantity > 0 %}
      {% unless hide_variant_picker_when_quantity_1 and option_1_quantity == 1 %}
        {% assign show_picker_1 = true %}
      {% endunless %}
    {% endif %}
    <button
      type="button"
      class="quantity-breaks__card{% if option_1_recommended %} quantity-breaks__card--recommended{% endif %}{% if option_1_sold_out %} quantity-breaks__card--sold-out{% endif %}"
      data-option-index="1"
      {% if option_1_sold_out %}disabled aria-label="Sold out"{% endif %}
      data-quantity="{{ option_1_quantity }}"
      data-variant-id="{{ variant.id }}"
      {% if show_picker_1 %}data-variant-ids="{% for i in (1..option_1_quantity) %}{{ variant.id }}{% unless forloop.last %},{% endunless %}{% endfor %}" data-has-variant-pickers="true" data-variant-picker-count="{{ option_1_quantity }}"{% endif %}
      data-discount="{{ option_1_discount }}"
      data-discount-type="{{ option_1_discount_type }}"
      data-discount-amount="{{ option_1_discount_amount }}"
      data-final-price-cents="{{ option_1_final_price }}"
      data-compare-price-cents="{{ option_1_compare_price }}"
      data-show-per-unit="{% if block_settings.show_price_per_unit == true %}true{% else %}false{% endif %}"
      {% if block_settings.option_1_discount_code != blank %}data-discount-code="{{ block_settings.option_1_discount_code | escape }}"{% endif %}
      aria-label="Select quantity {{ option_1_quantity }}"
    >
      {% if option_1_sold_out %}
        <span class="quantity-breaks__sold-out-badge">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
      {% elsif block_settings.option_1_badge_text != blank %}
        {% assign badge_text = block_settings.option_1_badge_text %}
        {% capture saved_amount_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_1_discount_calculated %}{% endcapture %}
        {% if option_1_effective_discount > 0 %}
          {% assign discount_value = option_1_effective_discount | round | append: '%' %}
          <span class="quantity-breaks__recommended-badge">{{ badge_text | replace: '[%]', discount_value | replace: '[amount]', saved_amount_formatted }}</span>
        {% else %}
          <span class="quantity-breaks__recommended-badge">{{ badge_text | replace: '[%]', '0%' | replace: '[amount]', saved_amount_formatted }}</span>
        {% endif %}
      {% elsif option_1_gifts_count > 0 %}
        <span class="quantity-breaks__free-gifts-badge visually-hidden">{{ option_1_gifts_count }} FREE GIFTS</span>
      {% endif %}
      
