  data-money-format="{{ shop.money_format | escape }}"
  data-currency="{{ cart.currency.iso_code | escape }}"
  data-per-unit-text="{% if block_settings.per_unit_text != blank and block_settings.show_price_per_unit == true %}{{ block_settings.per_unit_text }}{% else %}{% endif %}"
  data-currency-code-enabled="false"
  data-compare-price-type="{{ compare_price_type }}"
  data-override-product-price="{% if block_settings.override_product_price == true %}true{% else %}false{% endif %}"
  data-recommended-badge-style="{{ block_settings.recommended_badge_style | default: 'rounded' }}"
  style="
    {% render 'spacing-style', settings: block_settings %}
    --columns-desktop: {{ block_settings.columns_per_row_desktop | default: 3 }};
    --columns-mobile: {{ block_settings.columns_per_row_mobile | default: 1 }};
    --container-gap-desktop: {{ block_settings.container_gap_desktop | default: 16 }}px;
    --container-gap-mobile: {{ block_settings.container_gap_mobile | default: 16 }}px;
    --container-padding-top-desktop: {{ block_settings.container_padding_top_desktop | default: 14 }}px;
    --container-padding-top-mobile: {{ block_settings.container_padding_top_mobile | default: 14 }}px;
    --is-single-column-desktop: {% if block_settings.columns_per_row_desktop == 1 %}1{% else %}0{% endif %};
    --is-single-column-mobile: {% if block_settings.columns_per_row_mobile == 1 %}1{% else %}0{% endif %};
    --two-column-layout-desktop: {% if block_settings.two_column_layout_desktop == 'vertical' %}vertical{% else %}horizontal{% endif %};
    --two-column-layout-mobile: {% if block_settings.two_column_layout_mobile == 'vertical' %}vertical{% else %}horizontal{% endif %};
    --card-radius: {{ block_settings.card_radius | default: 12 }}px;
    --heading-font-family: {{ block_settings.heading_font_family | default: 'var(--font-heading--family)' }};
    --heading-text-size: {{ block_settings.heading_text_size | default: 24 }}px;
    --heading-text-size-mobile: {{ block_settings.heading_text_size_mobile | default: 20 }}px;
    --title-font-family: {{ block_settings.title_font_family | default: 'var(--font-heading--family)' }};
    --price-font-family: {{ block_settings.price_font_family | default: 'var(--font-body--family)' }};
    --title-text-size: {{ block_settings.title_text_size | default: 18 }}px;
    --title-text-size-mobile: {{ block_settings.title_text_size_mobile | default: 16 }}px;
    --description-text-size: {{ block_settings.description_text_size | default: 14 }}px;
    --description-text-size-mobile: {{ block_settings.description_text_size_mobile | default: 12 }}px;
    --price-text-size: {{ block_settings.price_text_size | default: 20 }}px;
    --price-text-size-mobile: {{ block_settings.price_text_size_mobile | default: 18 }}px;
    --compare-price-text-size: {{ block_settings.compare_price_text_size | default: 14 }}px;
    --per-unit-text-size: {{ block_settings.per_unit_text_size | default: 14 }}px;
    --per-unit-text-size-mobile: {{ block_settings.per_unit_text_size_mobile | default: 12 }}px;
    --badge-text-size: {{ block_settings.badge_text_size | default: 12 }}px;
    --badge-text-size-mobile: {{ block_settings.badge_text_size_mobile | default: 12 }}px;
    --discount-badge-text-size: {{ block_settings.discount_badge_text_size | default: 12 }}px;
    --badge-radius: {{ block_settings.badge_radius | default: 4 }}px;
    --discount-badge-radius: {{ block_settings.discount_badge_radius | default: 4 }}px;
    --card-border-width-selected: {{ block_settings.card_border_width_selected | default: 2 }}px;
    --card-border-width-unselected: {{ block_settings.card_border_width_unselected | default: 1 }}px;
    --image-size: {{ block_settings.image_size | default: 60 }}px;
    --scalloped-badge-size: {{ block_settings.scalloped_badge_size | default: 60 }}px;
    --recommended-badge-bg: {{ block_settings.recommended_badge_bg | default: '#4caf50' }};
    --recommended-badge-text: {{ block_settings.recommended_badge_text | default: '#ffffff' }};
    --discount-badge-bg: {{ block_settings.discount_badge_bg | default: '#4caf50' }};
    --discount-badge-text: {{ block_settings.discount_badge_text | default: '#ffffff' }};
    --price-color: {{ block_settings.price_color | default: '#000000' }};
    --compare-price-color: {{ block_settings.compare_price_color | default: '#999999' }};
    --active-price-color: {{ block_settings.active_price_color | default: '#000000' }};
    --active-compare-price-color: {{ block_settings.active_compare_price_color | default: '#999999' }};
    --radio-color: {{ block_settings.radio_color | default: '#8B4513' }};
    --price-font-weight: {% if block_settings.bold_prices %}700{% else %}400{% endif %};
    --compare-price-font-weight: {% if block_settings.bold_prices %}700{% else %}400{% endif %};
    --free-gifts-background: {% if block_settings.free_gifts_background_enabled %}{{ block_settings.free_gifts_background_color | default: '#f5f5f5' }}{% else %}transparent{% endif %};
    --free-gifts-border-width: {{ block_settings.free_gifts_border_width | default: 2 }}px;
    --free-gifts-border-style: {{ block_settings.free_gifts_border_style | default: 'solid' }};
    --free-gifts-border-color: {{ block_settings.free_gifts_border_color | default: '#e0e0e0' }};
    --free-gifts-per-row-desktop: {{ block_settings.free_gifts_per_row_desktop | default: '3' }};
    --free-gifts-per-row-mobile: {{ block_settings.free_gifts_per_row_mobile | default: '2' }};
    --free-gifts-gap: {{ block_settings.free_gifts_gap | default: 28 }}px;
    --free-gifts-locked-background: {{ block_settings.free_gifts_locked_background_color | default: '#e8e8e8' }};
    --free-gifts-locked-text: {{ block_settings.free_gifts_locked_text_color | default: '#666666' }};
    --free-gifts-badge-background: {{ block_settings.free_gifts_badge_background_color | default: '#f5c6d6' }};
    --free-gifts-badge-text: {{ block_settings.free_gifts_badge_text_color | default: '#ffffff' }};
    --free-gifts-badge-border: {{ block_settings.free_gifts_badge_border_color | default: '#e8a4b8' }};
    --sold-out-badge-bg: {{ block_settings.sold_out_badge_background | default: '#999999' }};
    --sold-out-badge-text: {{ block_settings.sold_out_badge_text | default: '#ffffff' }};
    {% liquid
      assign sold_out_card_bg_setting = block_settings.sold_out_card_background | default: 'transparent'
      assign sold_out_card_normalized = sold_out_card_bg_setting | strip | downcase | replace: ' ', ''
      assign sold_out_use_card_bg = true
      if sold_out_card_bg_setting == blank or sold_out_card_normalized == 'transparent'
        assign sold_out_use_card_bg = false
      elsif sold_out_card_normalized == '#00000000' or sold_out_card_normalized == 'rgba(0,0,0,0)'
        assign sold_out_use_card_bg = false
      endif
