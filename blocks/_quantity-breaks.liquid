    font-size: var(--title-text-size, 1.125rem);
    color: var(--color-variant-text, var(--color-foreground-heading, #000));
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  
  .quantity-breaks__card--active .quantity-breaks__quantity-title {
    color: var(--color-selected-variant-text, var(--color-variant-text, var(--color-foreground-heading, #000)));
  }
  
  .quantity-breaks__description {
    margin: 0;
    font-size: var(--description-text-size, 0.875rem);
    color: var(--color-variant-text, var(--color-foreground, #666));
    word-wrap: break-word;
    overflow-wrap: break-word;
    width: 100%;
  }
  
  .quantity-breaks__card--active .quantity-breaks__description {
    color: var(--color-selected-variant-text, var(--color-variant-text, var(--color-foreground, #666)));
  }
  
  .quantity-breaks__content .quantity-breaks__variant-pickers {
    margin-top: 2px;
    width: 100%;
    min-width: 100%;
    flex-basis: 100%;
    max-width: 100%;
    flex: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Preselected card: reserve space when inactive (only before user selects another option) */
  [data-quantity-breaks-component]:not([data-user-has-selected-other="true"]) .quantity-breaks__card--recommended:not(.quantity-breaks__card--active) .quantity-breaks__variant-pickers {
    visibility: hidden;
    pointer-events: none;
  }

  /* Non-preselected cards: hide without reserving space */
  .quantity-breaks__card:not(.quantity-breaks__card--recommended):not(.quantity-breaks__card--active) .quantity-breaks__variant-pickers {
    display: none;
  }

  /* After user selects another option: all inactive cards use display: none */
  [data-quantity-breaks-component][data-user-has-selected-other="true"] .quantity-breaks__card:not(.quantity-breaks__card--active) .quantity-breaks__variant-pickers {
    display: none;
  }

  .quantity-breaks__variant-pickers-heading {
    font-size: var(--description-text-size, 0.875rem);
    color: var(--color-selected-variant-text, var(--color-foreground, #333));
    margin-bottom: 2px;
    text-align: left;
    margin-left: 31px;
  }

  .quantity-breaks__variant-pickers--no-row-numbers .quantity-breaks__variant-pickers-heading {
    margin-left: 0;
    text-align: center;
  }

  .quantity-breaks__variant-picker-row {
    display: flex;
    align-items: center;
    gap: 10px;
   /* width: 100%;*/
    text-align: left;
  }

  .quantity-breaks__variant-picker-select-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .quantity-breaks__variant-swatch {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--swatch-background, #eee);
    background-size: cover;
    background-position: center;
    display: block;
  }

  .quantity-breaks__variant-select--has-swatch {
    min-width: 60px;
  }

  [data-variant-picker-full-width="true"] .quantity-breaks__variant-select--has-swatch {
    flex: 1;
  }

  .quantity-breaks__variant-picker-number {
    font-size: var(--description-text-size, 0.875rem);
    color: var(--color-selected-variant-text, var(--color-foreground, #666));
    min-width: 0.5em;
    flex-shrink: 0;
  }

  .quantity-breaks__variant-picker-row .quantity-breaks__variant-select {
    min-width: 30px;
  }
  
  .quantity-breaks__variant-select {
    padding: 6px 8px;
    font-size: var(--description-text-size, 0.875rem);
    border: 1px solid var(--color-variant-border, var(--color-border, #e0e0e0));
    border-radius: 6px;
    background-color: var(--color-variant-background, #fff);
    color: var(--color-input-text, var(--color-foreground, #000));
    cursor: pointer;
    appearance: auto;
    -webkit-appearance: menulist;
  }
  
  .quantity-breaks__card--active .quantity-breaks__variant-select {
    border-color: var(--color-selected-variant-text, var(--radio-color, #8B4513));
  }
  [data-variant-picker-full-width="true"] .quantity-breaks__card--active .quantity-breaks__variant-select {
    flex: 1;
  }
  
  .quantity-breaks__discount-badge {
    background-color: var(--discount-badge-bg, #4caf50);
    color: var(--discount-badge-text, #ffffff);
    padding: 4px 6px;
    border-radius: var(--discount-badge-radius, 4px);
    font-size: var(--discount-badge-text-size, 0.75rem);
    margin: 0;
  }
  
  .quantity-breaks__price-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    padding-top: 8px;
  }
  
  /* Single column and two columns horizontal: align price to right */
  @media screen and (min-width: 750px) {
    .quantity-breaks__container:has([style*="--columns-desktop: 1"]) .quantity-breaks__price-container,
    .quantity-breaks__container[data-columns-desktop="1"] .quantity-breaks__price-container,
    .quantity-breaks__container[data-columns-desktop="2"][data-two-column-layout-desktop="horizontal"] .quantity-breaks__price-container {
      align-items: flex-end;
      margin-top: 0;
      padding-top: 0;
    }
  }
  
  @media screen and (max-width: 749px) {
    .quantity-breaks__container:has([style*="--columns-mobile: 1"]) .quantity-breaks__price-container,
    .quantity-breaks__container[data-columns-mobile="1"] .quantity-breaks__price-container,
    .quantity-breaks__container[data-columns-mobile="2"][data-two-column-layout-mobile="horizontal"] .quantity-breaks__price-container {
      align-items: flex-end;
      margin-top: 0;
      padding-top: 0;
    }
  }
  
  .quantity-breaks__price {
    font-family: var(--price-font-family, inherit);
    font-size: var(--price-text-size, 1.25rem);
    font-weight: var(--price-font-weight, 600);
    color: var(--price-color, var(--color-variant-text, var(--color-foreground-heading, #000)));
    line-height: 1;
    letter-spacing: -0.03rem;
  }
  
  .quantity-breaks__card--active .quantity-breaks__price {
    color: var(--active-price-color, var(--price-color, var(--color-selected-variant-text, var(--color-variant-text, var(--color-foreground-heading, #000)))));
  }
  
  .quantity-breaks__original-price {
    font-family: var(--price-font-family, inherit);
    font-size: var(--compare-price-text-size, 0.875rem);
    font-weight: var(--compare-price-font-weight, 400);
    color: var(--compare-price-color, var(--color-variant-text, var(--color-foreground-secondary, #999)));
    text-decoration: none;
    line-height: 1;
    letter-spacing: -0.03rem;
  }
  
  .quantity-breaks__card--active .quantity-breaks__original-price {
    color: var(--active-compare-price-color, var(--compare-price-color, var(--color-selected-variant-text, var(--color-variant-text, var(--color-foreground-secondary, #999)))));
  }
  
  .quantity-breaks__per-unit-text {
    font-size: var(--per-unit-text-size, 0.875rem);
  }
  
  @media screen and (max-width: 749px) {
    .quantity-breaks__card {
      min-height: auto;
    }
    
    .quantity-breaks__quantity-title {
      font-size: var(--title-text-size-mobile, 1rem);
    }
    
    .quantity-breaks__description {
      font-size: var(--description-text-size-mobile, 0.75rem);
    }
    
    .quantity-breaks__price {
      font-size: var(--price-text-size-mobile, 1.125rem);
    }
    
    .quantity-breaks__per-unit-text {
      font-size: var(--per-unit-text-size-mobile, 0.75rem);
    }
    
  }

  .quantity-breaks__ancher-target {
    display: block;
    height: 0;
    overflow: hidden;
    scroll-margin-top: calc(var(--header-group-height, 0px) + var(--scroll-margin, 12px));
    pointer-events: none;
  }
