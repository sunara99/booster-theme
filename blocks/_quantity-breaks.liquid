
{% liquid
  assign block_settings = block.settings
  comment
    Main product for quantity break pricing. closest.product can resolve to gift_1_product
    when the block has gift product settings, so we use template product first.
  endcomment
  assign product = product | default: closest.product
  assign variant = product.selected_or_first_available_variant
  
  # Get base price and compare at price
  assign base_price = variant.price
  assign base_compare_at_price = variant.compare_at_price
  if base_compare_at_price == blank or base_compare_at_price == 0
    assign base_compare_at_price = base_price
  endif
  
  # Determine image to use for each option
  # Priority: custom image > variant image > product featured image
  if block_settings.show_images == true
    assign show_images = true
  else
    assign show_images = false
  endif
  
  # Get variant image (try featured_media.preview_image first, then featured_image)
  assign variant_image = blank
  if variant.featured_media != blank and variant.featured_media.preview_image != blank
    assign variant_image = variant.featured_media.preview_image
  elsif variant.featured_image != blank
    assign variant_image = variant.featured_image
  elsif product.featured_image != blank
    assign variant_image = product.featured_image
  endif
  
  # Option 1 image
  if block_settings.option_1_custom_image != blank
    assign option_1_image = block_settings.option_1_custom_image
  elsif variant_image != blank
    assign option_1_image = variant_image
  else
    assign option_1_image = blank
  endif
  
  # Option 2 image
  if block_settings.option_2_custom_image != blank
    assign option_2_image = block_settings.option_2_custom_image
  elsif variant_image != blank
    assign option_2_image = variant_image
  else
    assign option_2_image = blank
  endif
  
  # Option 3 image
  if block_settings.option_3_custom_image != blank
    assign option_3_image = block_settings.option_3_custom_image
  elsif variant_image != blank
    assign option_3_image = variant_image
  else
    assign option_3_image = blank
  endif
  
  # Option 4 image
  if block_settings.option_4_custom_image != blank
    assign option_4_image = block_settings.option_4_custom_image
  elsif variant_image != blank
    assign option_4_image = variant_image
  else
    assign option_4_image = blank
  endif
  
  # Option 5 image
  if block_settings.option_5_custom_image != blank
    assign option_5_image = block_settings.option_5_custom_image
  elsif variant_image != blank
    assign option_5_image = variant_image
  else
    assign option_5_image = blank
  endif
  
  # Option 6 image
  if block_settings.option_6_custom_image != blank
    assign option_6_image = block_settings.option_6_custom_image
  elsif variant_image != blank
    assign option_6_image = variant_image
  else
    assign option_6_image = blank
  endif
  
  # Calculate image size for URL (2x for retina)
  assign image_size = block_settings.image_size | default: 60
  assign image_url_width = image_size | times: 2
  
  # Define quantity options (can be configured in settings)
  assign option_1_enabled = block_settings.option_1_enabled
  assign option_1_quantity = block_settings.option_1_quantity | default: 1
  assign option_1_discount_type = block_settings.option_1_discount_type | default: 'percentage'
  assign option_1_discount = block_settings.option_1_discount | default: 0
  assign option_1_discount_amount = block_settings.option_1_discount_amount | default: 0
  assign preselected_option = block_settings.preselected_option | default: 'option_2'
  assign option_1_recommended = false
  if preselected_option == 'option_1'
    assign option_1_recommended = true
  endif
  
  assign option_2_enabled = block_settings.option_2_enabled
  assign option_2_quantity = block_settings.option_2_quantity | default: 2
  assign option_2_discount_type = block_settings.option_2_discount_type | default: 'percentage'
  assign option_2_discount = block_settings.option_2_discount | default: 10
  assign option_2_discount_amount = block_settings.option_2_discount_amount | default: 0
  assign option_2_recommended = false
  if preselected_option == 'option_2'
    assign option_2_recommended = true
  endif
  
  assign option_3_enabled = block_settings.option_3_enabled
  assign option_3_quantity = block_settings.option_3_quantity | default: 3
  assign option_3_discount_type = block_settings.option_3_discount_type | default: 'percentage'
  assign option_3_discount = block_settings.option_3_discount | default: 15
  assign option_3_discount_amount = block_settings.option_3_discount_amount | default: 0
  assign option_3_recommended = false
  if preselected_option == 'option_3'
    assign option_3_recommended = true
  endif
  
  assign option_4_enabled = block_settings.option_4_enabled
  assign option_4_quantity = block_settings.option_4_quantity | default: 0
  assign option_4_discount_type = block_settings.option_4_discount_type | default: 'percentage'
  assign option_4_discount = block_settings.option_4_discount | default: 0
  assign option_4_discount_amount = block_settings.option_4_discount_amount | default: 0
  assign option_4_recommended = false
  if preselected_option == 'option_4'
    assign option_4_recommended = true
  endif
  
  assign option_5_enabled = block_settings.option_5_enabled
  assign option_5_quantity = block_settings.option_5_quantity | default: 0
  assign option_5_discount_type = block_settings.option_5_discount_type | default: 'percentage'
  assign option_5_discount = block_settings.option_5_discount | default: 0
  assign option_5_discount_amount = block_settings.option_5_discount_amount | default: 0
  assign option_5_recommended = false
  if preselected_option == 'option_5'
    assign option_5_recommended = true
  endif
  
  assign option_6_enabled = block_settings.option_6_enabled
  assign option_6_quantity = block_settings.option_6_quantity | default: 0
  assign option_6_discount_type = block_settings.option_6_discount_type | default: 'percentage'
  assign option_6_discount = block_settings.option_6_discount | default: 0
  assign option_6_discount_amount = block_settings.option_6_discount_amount | default: 0
  assign option_6_recommended = false
  if preselected_option == 'option_6'
    assign option_6_recommended = true
  endif
  
  assign option_1_sold_out = block_settings.option_1_sold_out | default: false
  assign option_2_sold_out = block_settings.option_2_sold_out | default: false
  assign option_3_sold_out = block_settings.option_3_sold_out | default: false
  assign option_4_sold_out = block_settings.option_4_sold_out | default: false
  assign option_5_sold_out = block_settings.option_5_sold_out | default: false
  assign option_6_sold_out = block_settings.option_6_sold_out | default: false
  
  # Variant picker for all quantity options
  assign show_variant_picker = block_settings.show_variant_picker | default: false
  assign hide_variant_picker_when_quantity_1 = block_settings.hide_variant_picker_when_quantity_1 | default: false
  assign show_variant_pickers_heading = block_settings.show_variant_pickers_heading
  if show_variant_pickers_heading == nil
    assign show_variant_pickers_heading = true
  endif
  assign show_variant_picker_row_numbers = block_settings.show_variant_picker_row_numbers
  if show_variant_picker_row_numbers == nil
    assign show_variant_picker_row_numbers = true
  endif
  assign show_quantity_breaks_radio_indicator = block_settings.show_quantity_breaks_radio_indicator
  if show_quantity_breaks_radio_indicator == nil
    assign show_quantity_breaks_radio_indicator = true
  endif
  assign product_has_variants = false
  if product.has_only_default_variant == false
    assign product_has_variants = true
  endif
  
  # Determine compare price type
  assign compare_price_type = block_settings.compare_price_type | default: 'calculated'
  assign show_compare_when_original = false
  if compare_price_type == 'original' and base_compare_at_price > base_price
    assign show_compare_when_original = true
  endif
  
  # Calculate prices (round final to match Shopify cart - add 1 cent when discount remainder >= 50)
  assign option_1_total = base_price | times: option_1_quantity
  if option_1_discount_type == 'fixed'
    assign option_1_discount_calculated = option_1_discount_amount
  else
    assign option_1_discount_raw = option_1_total | times: option_1_discount
    assign option_1_discount_calculated = option_1_discount_raw | divided_by: 100
  endif
  assign option_1_final_price = option_1_total | minus: option_1_discount_calculated
  if option_1_discount_type != 'fixed'
    assign option_1_discount_remainder = option_1_discount_raw | modulo: 100
    if option_1_discount_remainder >= 1
      assign option_1_final_price = option_1_final_price | plus: 1
    endif
  endif
  # Calculate effective discount percentage for display
  if option_1_discount_type == 'fixed' and option_1_total > 0
    assign option_1_effective_discount = option_1_discount_calculated | times: 100 | divided_by: option_1_total
  else
    assign option_1_effective_discount = option_1_discount
  endif
  if compare_price_type == 'original'
    assign option_1_compare_price = base_compare_at_price | times: option_1_quantity
  else
    assign option_1_compare_price = option_1_total
  endif
  
  assign option_2_total = base_price | times: option_2_quantity
  if option_2_discount_type == 'fixed'
    assign option_2_discount_calculated = option_2_discount_amount
  else
    assign option_2_discount_raw = option_2_total | times: option_2_discount
    assign option_2_discount_calculated = option_2_discount_raw | divided_by: 100
  endif
  assign option_2_final_price = option_2_total | minus: option_2_discount_calculated
  if option_2_discount_type != 'fixed'
    assign option_2_discount_remainder = option_2_discount_raw | modulo: 100
    if option_2_discount_remainder >= 1
      assign option_2_final_price = option_2_final_price | plus: 1
    endif
  endif
  # Calculate effective discount percentage for display
  if option_2_discount_type == 'fixed' and option_2_total > 0
    assign option_2_effective_discount = option_2_discount_calculated | times: 100 | divided_by: option_2_total
  else
    assign option_2_effective_discount = option_2_discount
  endif
  if compare_price_type == 'original'
    assign option_2_compare_price = base_compare_at_price | times: option_2_quantity
  else
    assign option_2_compare_price = option_2_total
  endif
  
  assign option_3_total = base_price | times: option_3_quantity
  if option_3_discount_type == 'fixed'
    assign option_3_discount_calculated = option_3_discount_amount
  else
    assign option_3_discount_raw = option_3_total | times: option_3_discount
    assign option_3_discount_calculated = option_3_discount_raw | divided_by: 100
  endif
  assign option_3_final_price = option_3_total | minus: option_3_discount_calculated
  if option_3_discount_type != 'fixed'
    assign option_3_discount_remainder = option_3_discount_raw | modulo: 100
    if option_3_discount_remainder >= 1
      assign option_3_final_price = option_3_final_price | plus: 1
    endif
  endif
  # Calculate effective discount percentage for display
  if option_3_discount_type == 'fixed' and option_3_total > 0
    assign option_3_effective_discount = option_3_discount_calculated | times: 100 | divided_by: option_3_total
  else
    assign option_3_effective_discount = option_3_discount
  endif
  if compare_price_type == 'original'
    assign option_3_compare_price = base_compare_at_price | times: option_3_quantity
  else
    assign option_3_compare_price = option_3_total
  endif
  
  assign option_4_total = base_price | times: option_4_quantity
  if option_4_discount_type == 'fixed'
    assign option_4_discount_calculated = option_4_discount_amount
  else
    assign option_4_discount_raw = option_4_total | times: option_4_discount
    assign option_4_discount_calculated = option_4_discount_raw | divided_by: 100
  endif
  assign option_4_final_price = option_4_total | minus: option_4_discount_calculated
  if option_4_discount_type != 'fixed'
    assign option_4_discount_remainder = option_4_discount_raw | modulo: 100
    if option_4_discount_remainder >= 1
      assign option_4_final_price = option_4_final_price | plus: 1
    endif
  endif
  # Calculate effective discount percentage for display
  if option_4_discount_type == 'fixed' and option_4_total > 0
    assign option_4_effective_discount = option_4_discount_calculated | times: 100 | divided_by: option_4_total
  else
    assign option_4_effective_discount = option_4_discount
  endif
  if compare_price_type == 'original'
    assign option_4_compare_price = base_compare_at_price | times: option_4_quantity
  else
    assign option_4_compare_price = option_4_total
  endif
  
  assign option_5_total = base_price | times: option_5_quantity
  if option_5_discount_type == 'fixed'
    assign option_5_discount_calculated = option_5_discount_amount
  else
    assign option_5_discount_raw = option_5_total | times: option_5_discount
    assign option_5_discount_calculated = option_5_discount_raw | divided_by: 100
  endif
  assign option_5_final_price = option_5_total | minus: option_5_discount_calculated
  if option_5_discount_type != 'fixed'
    assign option_5_discount_remainder = option_5_discount_raw | modulo: 100
    if option_5_discount_remainder >= 1
      assign option_5_final_price = option_5_final_price | plus: 1
    endif
  endif
  # Calculate effective discount percentage for display
  if option_5_discount_type == 'fixed' and option_5_total > 0
    assign option_5_effective_discount = option_5_discount_calculated | times: 100 | divided_by: option_5_total
  else
    assign option_5_effective_discount = option_5_discount
  endif
  if compare_price_type == 'original'
    assign option_5_compare_price = base_compare_at_price | times: option_5_quantity
  else
    assign option_5_compare_price = option_5_total
  endif
  
  assign option_6_total = base_price | times: option_6_quantity
  if option_6_discount_type == 'fixed'
    assign option_6_discount_calculated = option_6_discount_amount
  else
    assign option_6_discount_raw = option_6_total | times: option_6_discount
    assign option_6_discount_calculated = option_6_discount_raw | divided_by: 100
  endif
  assign option_6_final_price = option_6_total | minus: option_6_discount_calculated
  if option_6_discount_type != 'fixed'
    assign option_6_discount_remainder = option_6_discount_raw | modulo: 100
    if option_6_discount_remainder >= 1
      assign option_6_final_price = option_6_final_price | plus: 1
    endif
  endif
  # Calculate effective discount percentage for display
  if option_6_discount_type == 'fixed' and option_6_total > 0
    assign option_6_effective_discount = option_6_discount_calculated | times: 100 | divided_by: option_6_total
  else
    assign option_6_effective_discount = option_6_discount
  endif
  if compare_price_type == 'original'
    assign option_6_compare_price = base_compare_at_price | times: option_6_quantity
  else
    assign option_6_compare_price = option_6_total
  endif
  
  # Format prices (quantity breaks never show currency code on product page)
%}
{% capture option_1_final_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_1_final_price %}{% endcapture %}
{% capture option_1_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_1_compare_price %}{% endcapture %}
{% capture option_2_final_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_2_final_price %}{% endcapture %}
{% capture option_2_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_2_compare_price %}{% endcapture %}
{% capture option_3_final_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_3_final_price %}{% endcapture %}
{% capture option_3_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_3_compare_price %}{% endcapture %}
{% capture option_4_final_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_4_final_price %}{% endcapture %}
{% capture option_4_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_4_compare_price %}{% endcapture %}
{% capture option_5_final_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_5_final_price %}{% endcapture %}
{% capture option_5_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_5_compare_price %}{% endcapture %}
{% capture option_6_final_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_6_final_price %}{% endcapture %}
{% capture option_6_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_6_compare_price %}{% endcapture %}
{%- liquid
  
  # Calculate per-unit prices if enabled
  if block_settings.show_price_per_unit == true
    if option_1_enabled == true and option_1_quantity > 0
      assign option_1_per_unit_price = option_1_final_price | divided_by: option_1_quantity
      assign option_1_per_unit_compare_price = option_1_compare_price | divided_by: option_1_quantity
    else
      assign option_1_per_unit_price = 0
      assign option_1_per_unit_compare_price = 0
    endif
    if option_2_enabled == true and option_2_quantity > 0
      assign option_2_per_unit_price = option_2_final_price | divided_by: option_2_quantity
      assign option_2_per_unit_compare_price = option_2_compare_price | divided_by: option_2_quantity
    else
      assign option_2_per_unit_price = 0
      assign option_2_per_unit_compare_price = 0
    endif
    if option_3_enabled == true and option_3_quantity > 0
      assign option_3_per_unit_price = option_3_final_price | divided_by: option_3_quantity
      assign option_3_per_unit_compare_price = option_3_compare_price | divided_by: option_3_quantity
    else
      assign option_3_per_unit_price = 0
      assign option_3_per_unit_compare_price = 0
    endif
    if option_4_enabled == true and option_4_quantity > 0
      assign option_4_per_unit_price = option_4_final_price | divided_by: option_4_quantity
      assign option_4_per_unit_compare_price = option_4_compare_price | divided_by: option_4_quantity
    else
      assign option_4_per_unit_price = 0
      assign option_4_per_unit_compare_price = 0
    endif
    if option_5_enabled == true and option_5_quantity > 0
      assign option_5_per_unit_price = option_5_final_price | divided_by: option_5_quantity
      assign option_5_per_unit_compare_price = option_5_compare_price | divided_by: option_5_quantity
    else
      assign option_5_per_unit_price = 0
      assign option_5_per_unit_compare_price = 0
    endif
    if option_6_enabled == true and option_6_quantity > 0
      assign option_6_per_unit_price = option_6_final_price | divided_by: option_6_quantity
      assign option_6_per_unit_compare_price = option_6_compare_price | divided_by: option_6_quantity
    else
      assign option_6_per_unit_price = 0
      assign option_6_per_unit_compare_price = 0
    endif
  endif

%}
{% if block_settings.show_price_per_unit == true %}
  {% capture option_1_per_unit_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_1_per_unit_price %}{% endcapture %}
  {% capture option_1_per_unit_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_1_per_unit_compare_price %}{% endcapture %}
  {% capture option_2_per_unit_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_2_per_unit_price %}{% endcapture %}
  {% capture option_2_per_unit_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_2_per_unit_compare_price %}{% endcapture %}
  {% capture option_3_per_unit_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_3_per_unit_price %}{% endcapture %}
  {% capture option_3_per_unit_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_3_per_unit_compare_price %}{% endcapture %}
  {% capture option_4_per_unit_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_4_per_unit_price %}{% endcapture %}
  {% capture option_4_per_unit_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_4_per_unit_compare_price %}{% endcapture %}
  {% capture option_5_per_unit_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_5_per_unit_price %}{% endcapture %}
  {% capture option_5_per_unit_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_5_per_unit_compare_price %}{% endcapture %}
  {% capture option_6_per_unit_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_6_per_unit_price %}{% endcapture %}
  {% capture option_6_per_unit_compare_price_formatted %}{% render 'price-split', context: 'quantity_breaks', cents: option_6_per_unit_compare_price %}{% endcapture %}
{% endif %}
{%- liquid

  # Free gifts config
  assign free_gifts_enabled = block_settings.free_gifts_enabled
  assign free_gifts_heading = block_settings.free_gifts_heading | default: '<p>Free Gift Set</p>'
  assign free_gifts_style = block_settings.free_gifts_style | default: 'card'
  assign free_gifts_image_fit = block_settings.free_gifts_image_fit | default: 'square'
  assign free_gifts_per_row_desktop = block_settings.free_gifts_per_row_desktop | default: '3'
  assign free_gifts_per_row_mobile = block_settings.free_gifts_per_row_mobile | default: '2'
  assign free_gifts_badge_display = block_settings.free_gifts_badge_display | default: 'free'
  assign free_gifts_background_enabled = block_settings.free_gifts_background_enabled
  assign gift_1_product = block_settings.gift_1_product
  assign gift_2_product = block_settings.gift_2_product
  assign gift_3_product = block_settings.gift_3_product
  assign gift_1_unlock = block_settings.gift_1_unlock_at | default: 'option_2'
  assign gift_2_unlock = block_settings.gift_2_unlock_at | default: 'option_2'
  assign gift_3_unlock = block_settings.gift_3_unlock_at | default: 'option_3'

  assign gift_custom_enabled = block_settings.gift_custom_enabled
  assign gift_custom_name = block_settings.gift_custom_name
  assign gift_custom_image = block_settings.gift_custom_image
  assign gift_custom_price = block_settings.gift_custom_price | default: 0
  assign gift_custom_compare_at_price = block_settings.gift_custom_compare_at_price | default: 0
  assign gift_custom_unlock = block_settings.gift_custom_unlock_at | default: 'option_2'
  assign gift_custom_position_num = block_settings.gift_custom_position | default: '4' | plus: 0

  assign gift_custom_2_enabled = block_settings.gift_custom_2_enabled
  assign gift_custom_2_name = block_settings.gift_custom_2_name
  assign gift_custom_2_image = block_settings.gift_custom_2_image
  assign gift_custom_2_price = block_settings.gift_custom_2_price | default: 0
  assign gift_custom_2_compare_at_price = block_settings.gift_custom_2_compare_at_price | default: 0
  assign gift_custom_2_unlock = block_settings.gift_custom_2_unlock_at | default: 'option_2'
  assign gift_custom_2_position_num = block_settings.gift_custom_2_position | default: '5' | plus: 0

  assign gift_custom_3_enabled = block_settings.gift_custom_3_enabled
  assign gift_custom_3_name = block_settings.gift_custom_3_name
  assign gift_custom_3_image = block_settings.gift_custom_3_image
  assign gift_custom_3_price = block_settings.gift_custom_3_price | default: 0
  assign gift_custom_3_compare_at_price = block_settings.gift_custom_3_compare_at_price | default: 0
  assign gift_custom_3_unlock = block_settings.gift_custom_3_unlock_at | default: 'option_3'
  assign gift_custom_3_position_num = block_settings.gift_custom_3_position | default: '6' | plus: 0
  assign gift_custom_show_price = block_settings.gift_custom_show_price
  assign gift_custom_2_show_price = block_settings.gift_custom_2_show_price
  assign gift_custom_3_show_price = block_settings.gift_custom_3_show_price

  if gift_custom_enabled or gift_custom_2_enabled or gift_custom_3_enabled
    assign c1_at_1 = 0
    if gift_custom_enabled and gift_custom_position_num <= 1
      assign c1_at_1 = 1
    endif
    assign c2_at_1 = 0
    if gift_custom_2_enabled and gift_custom_2_position_num <= 1
      assign c2_at_1 = 1
    endif
    assign c3_at_1 = 0
    if gift_custom_3_enabled and gift_custom_3_position_num <= 1
      assign c3_at_1 = 1
    endif
    assign customs_at_1 = c1_at_1 | plus: c2_at_1 | plus: c3_at_1

    assign c1_at_2 = 0
    if gift_custom_enabled and gift_custom_position_num <= 2
      assign c1_at_2 = 1
    endif
    assign c2_at_2 = 0
    if gift_custom_2_enabled and gift_custom_2_position_num <= 2
      assign c2_at_2 = 1
    endif
    assign c3_at_2 = 0
    if gift_custom_3_enabled and gift_custom_3_position_num <= 2
      assign c3_at_2 = 1
    endif
    assign customs_at_2 = c1_at_2 | plus: c2_at_2 | plus: c3_at_2

    assign c1_at_3 = 0
    if gift_custom_enabled and gift_custom_position_num <= 3
      assign c1_at_3 = 1
    endif
    assign c2_at_3 = 0
    if gift_custom_2_enabled and gift_custom_2_position_num <= 3
      assign c2_at_3 = 1
    endif
    assign c3_at_3 = 0
    if gift_custom_3_enabled and gift_custom_3_position_num <= 3
      assign c3_at_3 = 1
    endif
    assign customs_at_3 = c1_at_3 | plus: c2_at_3 | plus: c3_at_3

    assign gift_1_order = 1 | plus: customs_at_1
    assign gift_2_order = 2 | plus: customs_at_2
    assign gift_3_order = 3 | plus: customs_at_3

    if gift_custom_enabled
      assign gift_custom_1_order = 1
      if gift_custom_position_num >= 2
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 3
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 4
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 5
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 6
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_2_enabled and gift_custom_2_position_num < gift_custom_position_num
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_3_enabled and gift_custom_3_position_num < gift_custom_position_num
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
    endif

    if gift_custom_2_enabled
      assign gift_custom_2_order = 1
      if gift_custom_2_position_num >= 2
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_2_position_num >= 3
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_2_position_num >= 4
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_2_position_num >= 5
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_2_position_num >= 6
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_enabled and gift_custom_position_num <= gift_custom_2_position_num
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_3_enabled and gift_custom_3_position_num < gift_custom_2_position_num
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
    endif

    if gift_custom_3_enabled
      assign gift_custom_3_order = 1
      if gift_custom_3_position_num >= 2
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 3
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 4
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 5
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 6
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_enabled and gift_custom_position_num <= gift_custom_3_position_num
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_2_enabled and gift_custom_2_position_num <= gift_custom_3_position_num
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
    endif
  endif

  assign gift_discount_enabled = block_settings.gift_discount_enabled
  assign gift_discount_type = block_settings.gift_discount_type | default: 'percentage'
  assign gift_discount_value = block_settings.gift_discount_value | default: 50
  assign gift_discount_amount = block_settings.gift_discount_amount | default: 0
  assign gift_discount_code = block_settings.gift_discount_code | default: ''

  assign option_1_gifts_count = 0
  assign option_2_gifts_count = 0
  assign option_3_gifts_count = 0
  assign option_4_gifts_count = 0
  assign option_5_gifts_count = 0
  assign option_6_gifts_count = 0
  if free_gifts_enabled
    if gift_1_product != blank and gift_1_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif

    assign option_2_gifts_count = option_1_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif

    assign option_3_gifts_count = option_2_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif

    assign option_4_gifts_count = option_3_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif

    assign option_5_gifts_count = option_4_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif

    assign option_6_gifts_count = option_5_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
  endif

  assign display_scope = block_settings.display_scope | default: 'all'
  assign show_quantity_breaks = false
  if product != blank
    if display_scope == 'all'
      assign show_quantity_breaks = true
    elsif display_scope == 'selected_products'
      assign show_quantity_breaks = false
      if block_settings.display_products != blank
        for display_product in block_settings.display_products
          if display_product.id == product.id
            assign show_quantity_breaks = true
          endif
        endfor
      endif
    elsif display_scope == 'collection'
      assign show_quantity_breaks = false
      if block_settings.display_collections != blank
        for target_collection in block_settings.display_collections
          for product_collection in product.collections
            if product_collection.id == target_collection.id
              assign show_quantity_breaks = true
            endif
          endfor
        endfor
      endif
    endif
  endif
-%}

{% if show_quantity_breaks %}
<div
  class="quantity-breaks spacing-style{% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}"
  data-block-id="{{ block.id }}"
  data-quantity-breaks-component
  data-radio-indicator="{% if show_quantity_breaks_radio_indicator %}true{% else %}false{% endif %}"
