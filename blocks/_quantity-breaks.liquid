          <div class="quantity-breaks__product-image">
            <img
              src="{{ option_1_image | image_url: width: image_url_width }}"
              alt="{{ option_1_image.alt | default: product.title | escape }}"
              width="{{ image_size }}"
              height="{{ image_size }}"
              loading="lazy"
              data-option-image="1"
              data-custom-image="{% if block_settings.option_1_custom_image != blank %}true{% else %}false{% endif %}"
            >
          </div>
        </div>
        {% endif %}
        <div class="quantity-breaks__content-left">
