{% stylesheet %}
  .quantity-breaks {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
    border-radius: var(--card-radius, 12px);
  }
  
  .quantity-breaks__title {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    padding: 0 20px;
    gap: 20px;
  }
  
  .quantity-breaks__title::before,
  .quantity-breaks__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--color-border, #e0e0e0);
    min-width: 0;
  }
  
  .quantity-breaks__title::before {
    order: 1;
  }
  
  .quantity-breaks__heading {
    order: 2;
  }
  
  .quantity-breaks__title::after {
    order: 3;
  }
  
  .quantity-breaks__heading {
    margin: 0;
    font-family: var(--heading-font-family, inherit);
    font-size: var(--heading-text-size, 1.5rem);
    color: var(--color-foreground-heading, #000);
  }
  
  @media screen and (max-width: 749px) {
    .quantity-breaks__heading {
      font-size: var(--heading-text-size-mobile, 1.25rem);
    }
  }
  
  .quantity-breaks__container {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile, 1), 1fr);
    gap: var(--container-gap-mobile, 16px);
    padding-top: var(--container-padding-top-mobile, 14px);
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }
  
  @media screen and (min-width: 750px) {
    .quantity-breaks__container {
      grid-template-columns: repeat(var(--columns-desktop, 3), 1fr);
      gap: var(--container-gap-desktop, 16px);
      padding-top: var(--container-padding-top-desktop, 14px);
    }
  }
  
  .quantity-breaks__card {
    position: relative;
    background-color: var(--color-variant-background, #fff);
    border: var(--card-border-width-unselected, 1px) solid var(--color-variant-border, var(--color-border, #e0e0e0));
    border-radius: var(--card-radius, 12px);
    padding: 20px 8px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow: visible;
    color: var(--color-variant-text, var(--color-foreground, #000));
  }
  
  /*.quantity-breaks__card:has(.quantity-breaks__image-container) {
    min-height: 280px;
  }*/
  
  /* Single column layout - horizontal */
  @media screen and (min-width: 750px) {
    .quantity-breaks__container:has([style*="--columns-desktop: 1"]) .quantity-breaks__card,
    .quantity-breaks__container[data-columns-desktop="1"] .quantity-breaks__card {
      flex-direction: row;
      text-align: left;
      align-items: center;
      min-height: auto;
      padding: 16px;
      gap: 12px;
    }
  }
  
  @media screen and (max-width: 749px) {
    .quantity-breaks__container:has([style*="--columns-mobile: 1"]) .quantity-breaks__card,
    .quantity-breaks__container[data-columns-mobile="1"] .quantity-breaks__card {
      flex-direction: row;
      text-align: left;
      align-items: center;
      min-height: auto;
      padding: 16px;
      gap: 12px;
    }
  }
  
  /* Two columns layout - horizontal/vertical */
  @media screen and (min-width: 750px) {
    .quantity-breaks__container[data-columns-desktop="2"] .quantity-breaks__card {
      min-height: auto;
      padding: 16px 8px;
      gap: 12px;
    }
    
    .quantity-breaks__container[data-columns-desktop="2"][data-two-column-layout-desktop="horizontal"] .quantity-breaks__card {
      flex-direction: row;
      text-align: left;
      /*align-items: baseline;*/
    }
    
    .quantity-breaks__container[data-columns-desktop="2"][data-two-column-layout-desktop="vertical"] .quantity-breaks__card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }
  
  @media screen and (max-width: 749px) {
    .quantity-breaks__container[data-columns-mobile="2"] .quantity-breaks__card {
      min-height: auto;
      padding: 12px;
      gap: 12px;
    }
    .quantity-breaks__container[data-columns-mobile="2"][data-two-column-layout-mobile="horizontal"] .quantity-breaks__card {
      flex-direction: row;
      text-align: left;
      align-items: center;
    }
    
    .quantity-breaks__container[data-columns-mobile="2"][data-two-column-layout-mobile="vertical"] .quantity-breaks__card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }

  .quantity-breaks__container .quantity-breaks__card:has(.quantity-breaks__recommended-badge),
  .quantity-breaks__container .quantity-breaks__card:has(.quantity-breaks__sold-out-badge) {
    padding-top: calc(var(--badge-text-size, 12px) + 5px) !important;
  }

  /* Columns > 1: apply top padding to all cards for alignment */
  @media screen and (min-width: 750px) {
    .quantity-breaks__container[data-columns-desktop="2"] .quantity-breaks__card,
    .quantity-breaks__container[data-columns-desktop="3"] .quantity-breaks__card,
