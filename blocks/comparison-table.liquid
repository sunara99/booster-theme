{% liquid
  assign block_settings = block.settings
%}

<div
  class="comparison-table comparison-table--{{ block.id }} spacing-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
  "
  {{ block.shopify_attributes }}
>
  <div
    class="comparison-table__container"
    style="
      background-color: {{ block_settings.table_background }};
      border-radius: {{ block_settings.border_radius }}px;
      box-shadow: 0 0 0 1px {{ block_settings.table_background }};
    "
  >
    <table class="comparison-table__table" role="table">
      <thead>
        <tr class="comparison-table__header-row">
          <th class="comparison-table__header-cell comparison-table__header-cell--empty"
          style="
          background-color: {{ block_settings.outer_background | default: '#D4D8E2' }};
        "
      ></th>
          <th
            class="comparison-table__header-cell comparison-table__header-cell--column1"
            style="
              color: {{ block_settings.column1_header_color }};
              font-size: {{ block_settings.column1_header_size }}px;
              line-height: 1.1;
              background-color: {{ block_settings.outer_background | default: '#D4D8E2' }};
            "
          >
            {% if block_settings.column1_header_image != blank %}
              {% assign header_img_width = block_settings.column1_header_image_width | times: 2 %}
              <img
                src="{{ block_settings.column1_header_image | image_url: width: header_img_width }}"
                alt="{{ block_settings.column1_header | default: 'LOGO' | escape }}"
                class="comparison-table__header-image"
                style="max-width: {{ block_settings.column1_header_image_width }}px; height: auto; display: block; margin: 0 auto; object-fit: contain;"
                loading="lazy"
                width="{{ block_settings.column1_header_image_width }}"
                height="{{ block_settings.column1_header_image_width }}"
              >
            {% else %}
              {{ block_settings.column1_header | default: 'LOGO' }}
            {% endif %}
          </th>
          <th
            class="comparison-table__header-cell comparison-table__header-cell--column2"
            style="
              color: {{ block_settings.column2_header_color }};
              font-size: {{ block_settings.column2_header_size }}px;
              background-color: {{ block_settings.outer_background | default: '#D4D8E2' }};
            "
          >
            {{ block_settings.column2_header | default: 'Others' }}
          </th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..8) %}
          {% assign feature_key = 'feature_' | append: i %}
          {% assign feature_text = block_settings[feature_key] %}
          {% assign logo_icon_key = 'logo_icon_' | append: i %}
          {% assign others_icon_key = 'others_icon_' | append: i %}

          {% if feature_text != blank %}
            <tr
              class="comparison-table__row"
              style="
                border-color: {{ block_settings.row_border_color }};
              "
            >
              <td
                class="comparison-table__cell comparison-table__cell--feature"
                style="
                  background-color: {{ block_settings.feature_cell_background }};
                  color: {{ block_settings.feature_text_color }};
                  font-size: {{ block_settings.feature_text_size }}px;
                "
              >
                {{ feature_text }}
              </td>
              <td
                class="comparison-table__cell comparison-table__cell--column1"
                style="
                  background-color: {{ block_settings.column_cell_background }};
                  border-color: {{ block_settings.row_border_color }};
                "
              >
                {% assign logo_icon = block_settings[logo_icon_key] | default: 'check' %}
                {% if logo_icon == 'check' %}
                  <span class="comparison-table__icon comparison-table__icon--check" style="color: {{ block_settings.check_color }};">✓</span>
                {% elsif logo_icon == 'dash' %}
                  <span class="comparison-table__icon comparison-table__icon--dash" style="color: {{ block_settings.dash_color }};">—</span>
                {% else %}
                  <span class="comparison-table__icon comparison-table__icon--cross" style="color: {{ block_settings.cross_color }};">✗</span>
                {% endif %}
              </td>
              <td
                class="comparison-table__cell comparison-table__cell--column2"
                style="
                  background-color: {{ block_settings.column_cell_background }};
                  border-color: {{ block_settings.row_border_color }};
                "
              >
                {% assign others_icon = block_settings[others_icon_key] | default: 'cross' %}
                {% if others_icon == 'check' %}
                  <span class="comparison-table__icon comparison-table__icon--check" style="color: {{ block_settings.check_color }};">✓</span>
                {% elsif others_icon == 'dash' %}
                  <span class="comparison-table__icon comparison-table__icon--dash" style="color: {{ block_settings.dash_color }};">—</span>
                {% else %}
                  <span class="comparison-table__icon comparison-table__icon--cross" style="color: {{ block_settings.cross_color }};">✗</span>
                {% endif %}
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% stylesheet %}
  .comparison-table {
    width: 100%;
  }

  .comparison-table__container {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .comparison-table__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .comparison-table__header-row {
    border: none;
  }

  .comparison-table__header-cell {
    padding: 1rem 1.25rem;
    text-align: center;
    border: none;
  }

  .comparison-table__header-cell--empty {
    width: 45%;
    background: transparent;
  }

  .comparison-table__header-cell--column1 {
    width: 27.5%;
  }

  .comparison-table__header-cell--column2 {
    width: 27.5%;
  }

  .comparison-table__header-image {
    max-width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .comparison-table__row {
    border-top: 1px solid;
  }

  .comparison-table__cell {
    padding: 0.875rem 1.25rem;
    text-align: center;
    vertical-align: middle;
    border-left: 1px solid;
  }

  .comparison-table__cell--feature {
    text-align: center;
    width: 45%;
    border-left: none;
  }

  .comparison-table__cell--column1 {
    width: 27.5%;
  }

  .comparison-table__cell--column2 {
    width: 27.5%;
  }

  .comparison-table__icon {
    font-size: 1.25rem;
    font-weight: bold;
    display: inline-block;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .comparison-table__header-cell,
    .comparison-table__cell {
      padding: 0.75rem 0.875rem;
      font-size: 0.875rem;
    }

    .comparison-table__icon {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

