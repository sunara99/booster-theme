

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant

  assign product_price_block_regular_color = blank
  if block_settings.regular_price_color == 'custom' and block_settings.regular_price_color_custom != blank
    assign product_price_block_regular_color = block_settings.regular_price_color_custom
  elsif block_settings.regular_price_color != blank and block_settings.regular_price_color != 'custom'
    assign product_price_block_regular_color = block_settings.regular_price_color
  endif

  assign product_price_block_price_color = blank
  if block_settings.price_color == 'custom' and block_settings.price_color_custom != blank
    assign product_price_block_price_color = block_settings.price_color_custom
  elsif block_settings.price_color != blank and block_settings.price_color != 'custom'
    assign product_price_block_price_color = block_settings.price_color
  endif

  assign product_price_block_compare_color = blank
  if block_settings.compare_at_price_color == 'custom' and block_settings.compare_at_price_color_custom != blank
    assign product_price_block_compare_color = block_settings.compare_at_price_color_custom
  elsif block_settings.compare_at_price_color != blank and block_settings.compare_at_price_color != 'custom'
    assign product_price_block_compare_color = block_settings.compare_at_price_color
  endif

  assign product_price_block_compare_strike_color = blank
  if block_settings.compare_at_strike_color == 'custom' and block_settings.compare_at_strike_color_custom != blank
    assign product_price_block_compare_strike_color = block_settings.compare_at_strike_color_custom
  elsif block_settings.compare_at_strike_color != blank and block_settings.compare_at_strike_color != 'custom'
    assign product_price_block_compare_strike_color = block_settings.compare_at_strike_color
  endif
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
    endif
    if block_settings.color != '' or block_settings.color_mode == 'custom'
      echo ' custom-color'
    endif
    if block_settings.color_mode == 'custom' and block_settings.custom_color_style == 'gradient'
      echo ' custom-color-gradient'
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  data-show-sale-price-first="{% if block_settings.show_sale_price_first == true %}true{% else %}false{% endif %}"
  data-show-sale-badge="{% if block_settings.show_sale_badge %}true{% else %}false{% endif %}"
  data-sale-badge-type="{{ block_settings.sale_badge_type | default: 'percentage' }}"
  data-sale-badge-label="{{ 'content.product_badge_savings' | t }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --width: {{ block_settings.width }};
    {% if block_settings.show_sale_badge %}
      --sale-badge-font-size: {{ block_settings.sale_badge_font_size }}px; 
      --sale-badge-border-radius: {{ block_settings.sale_badge_border_radius | default: 4 }}px;
      {% if block_settings.sale_badge_color == 'custom' and block_settings.sale_badge_color_custom != blank %}--sale-badge-text-color: {{ block_settings.sale_badge_color_custom }};
      {% elsif block_settings.sale_badge_color != blank and block_settings.sale_badge_color != 'custom' %}--sale-badge-text-color: {{ block_settings.sale_badge_color }};{% endif %}
      {% if block_settings.sale_badge_background_color == 'custom' and block_settings.sale_badge_background_color_custom != blank %}--sale-badge-background-color: {{ block_settings.sale_badge_background_color_custom }};{% elsif block_settings.sale_badge_background_color != blank and block_settings.sale_badge_background_color != 'custom' %}--sale-badge-background-color: {{ block_settings.sale_badge_background_color }};{% endif %}
    {% endif %}
    {% if product_price_block_regular_color != blank %}--product-price-block-regular-color: {{ product_price_block_regular_color }};{% endif %}
    {% if product_price_block_price_color != blank %}--product-price-block-price-color: {{ product_price_block_price_color }};{% endif %}
    {% if product_price_block_compare_color != blank %}--product-price-block-compare-color: {{ product_price_block_compare_color }};{% endif %}
    {% if product_price_block_compare_strike_color != blank %}--product-price-block-compare-strike-color: {{ product_price_block_compare_strike_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% render 'price',
    show_unit_price: true,
    product_resource: product_resource,
    show_sale_price_first: block_settings.show_sale_price_first,
    show_sale_badge: block_settings.show_sale_badge,
    sale_badge_type: block_settings.sale_badge_type,
    sale_badge_text: block_settings.sale_badge_text
  %}

  {% if block_settings.show_tax_info %}
    <div class="tax-note">
      {%- if cart.duties_included and cart.taxes_included -%}
        {{ 'content.duties_and_taxes_included' | t }}
      {%- elsif cart.taxes_included -%}
        {{ 'content.taxes_included' | t }}
      {%- elsif cart.duties_included -%}
        {{ 'content.duties_included' | t }}
      {%- endif -%}

      {%- if shop.shipping_policy.body != blank -%}
        {{ 'content.shipping_policy' | t }}
      {%- endif -%}
    </div>
  {% endif %}

  {%- if selected_variant != blank and block_settings.show_installments -%}
    <div class="installments">
      {%- assign product_form_installment_id = 'product-form-installment-' | append: block.id -%}
      {%- form 'product', product_resource, id: product_form_installment_id, class: 'payment-terms' -%}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
        >
        {{ form | payment_terms }}
      {%- endform -%}
    </div>
  {%- endif -%}
</product-price>

{% # theme-check-disable %}
{% stylesheet %}
  product-price [ref="priceContainer"] {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-xs);
  }
  product-price.text-block--align-center >* {
    margin-inline: auto;
    justify-content: center;
}
  product-price.text-block--align-right >* {
    margin-inline-start: auto;
    justify-content: right;
}
  product-price.text-block--align-left >* {
    margin-inline-end: auto;
    justify-content: left;
}
  .tax-note:empty {
    display: none;
  }

  form.payment-terms {
    padding-top: 0.5em;
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .installments:not(:has(shopify-payment-terms)) {
    display: none;
  }

  product-price .sale-badge {
    display: inline-flex;
    gap: var(--gap-2xs);
    align-items: center;
    justify-content: center;
    align-self: center;
    padding: 0.25em 0.9em;
    font-size: var(--sale-badge-font-size);
    border-radius: var(--sale-badge-border-radius, 4px);
    color: var(--sale-badge-text-color, var(--color-foreground));
    -webkit-text-fill-color: var(--sale-badge-text-color, var(--color-foreground));
    background: var(--sale-badge-background-color, var(--color-background));
    vertical-align: middle;
  }

  /* Volume pricing note should match unit-price styling (small, grey text) */
  product-price .volume-pricing-note,
  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) .volume-pricing-note {
    display: block;
    font-family: var(--font-body--family);
    font-weight: normal;
    font-size: var(--font-size--xs);
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  product-price[data-block-id] [ref='priceContainer'] .price {
    color: var(--product-price-block-price-color, inherit);
  }

  product-price[data-block-id] [ref='priceContainer'] > .price:not(.price-range) {
    color: var(--product-price-block-regular-color, var(--product-price-block-price-color, inherit));
  }

  product-price[data-block-id] [ref='priceContainer']:not(:has(.compare-at-price)) .price.price-range {
    color: var(--product-price-block-regular-color, var(--product-price-block-price-color, inherit));
  }

  product-price[data-block-id] [ref='priceContainer'] .compare-at-price {
    color: var(--product-price-block-compare-color, inherit);
    opacity: 1;
  }

  product-price[data-block-id] [ref='priceContainer'] .compare-at-price .price-split::after,
  product-price[data-block-id] [ref='priceContainer'] s.compare-at-price .price-split::after {
    background: var(--product-price-block-compare-strike-color, currentColor);
  }

  product-price[data-block-id] [ref='priceContainer'] .compare-at-price .money,
  product-price[data-block-id] [ref='priceContainer'] s.compare-at-price .money {
    text-decoration-color: var(--product-price-block-compare-strike-color, currentColor);
  }
{% endstylesheet %}

