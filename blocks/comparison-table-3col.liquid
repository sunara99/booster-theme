{% liquid
  assign block_settings = block.settings

  assign show_col1 = false
  if block_settings.column1_header != blank or block_settings.column1_header_image != blank
    assign show_col1 = true
  endif

  assign show_col2 = false
  if block_settings.column2_header != blank
    assign show_col2 = true
  endif

  assign show_col3 = false
  if block_settings.column3_header != blank
    assign show_col3 = true
  endif

  if show_col3
    assign last_col = 'col3'
  elsif show_col2
    assign last_col = 'col2'
  else
    assign last_col = 'col1'
  endif

  case block_settings.box_shadow
    when 'soft'
      assign shadow_value = '0 2px 8px rgba(0,0,0,0.08)'
    when 'medium'
      assign shadow_value = '0 4px 16px rgba(0,0,0,0.12)'
    when 'strong'
      assign shadow_value = '0 8px 32px rgba(0,0,0,0.18)'
    else
      assign shadow_value = 'none'
  endcase

  assign border_style = block_settings.table_border_style | default: 'none'
  if border_style != 'none'
    assign border_value = block_settings.table_border_width | append: 'px ' | append: border_style | append: ' ' | append: block_settings.table_border_color
  else
    assign border_value = 'none'
  endif
%}

<div
  class="comparison-table-3col comparison-table-3col--{{ block.id }} spacing-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
  "
  {{ block.shopify_attributes }}
>
  <div
    class="comparison-table-3col__wrapper"
    style="
      border-radius: {{ block_settings.border_radius }}px;
      border: {{ border_value }};
      box-shadow: {{ shadow_value }};
    "
  >
    <table class="comparison-table-3col__table" role="table">
      <thead>
        <tr class="comparison-table-3col__header-row">
          <th
            class="comparison-table-3col__header-cell comparison-table-3col__header-cell--empty"
            style="background-color: {{ block_settings.feature_cell_background }}; border-radius: {{ block_settings.border_radius }}px 0 0 0;"
          ></th>
          {% if show_col1 %}
            <th
              class="comparison-table-3col__header-cell comparison-table-3col__header-cell--col1"
              style="
                color: {{ block_settings.column1_header_color }};
                font-size: {{ block_settings.column1_header_size }}px;
                background-color: {{ block_settings.table_background }};
                {% if last_col == 'col1' %}border-radius: 0 {{ block_settings.border_radius }}px 0 0;{% endif %}
              "
            >
              {% if block_settings.column1_header_image != blank %}
                {% assign header_img_width = block_settings.column1_header_image_width | times: 2 %}
                <img
                  src="{{ block_settings.column1_header_image | image_url: width: header_img_width }}"
                  alt="{{ block_settings.column1_header | default: 'Column 1' | escape }}"
                  class="comparison-table-3col__header-image"
                  style="max-width: {{ block_settings.column1_header_image_width }}px; height: auto; display: block; margin: 0 auto; object-fit: contain;"
                  loading="lazy"
                  width="{{ block_settings.column1_header_image_width }}"
                  height="{{ block_settings.column1_header_image_width }}"
                >
              {% else %}
                {{ block_settings.column1_header }}
              {% endif %}
            </th>
          {% endif %}
          {% if show_col2 %}
            <th
              class="comparison-table-3col__header-cell comparison-table-3col__header-cell--col2"
              style="
                color: {{ block_settings.column2_header_color }};
                font-size: {{ block_settings.column2_header_size }}px;
                background-color: {{ block_settings.table_background }};
                {% if last_col == 'col2' %}border-radius: 0 {{ block_settings.border_radius }}px 0 0;{% endif %}
              "
            >
              {{ block_settings.column2_header }}
            </th>
          {% endif %}
          {% if show_col3 %}
            <th
              class="comparison-table-3col__header-cell comparison-table-3col__header-cell--col3"
              style="
                color: {{ block_settings.column3_header_color }};
                font-size: {{ block_settings.column3_header_size }}px;
                background-color: {{ block_settings.table_background }};
                border-radius: 0 {{ block_settings.border_radius }}px 0 0;
              "
            >
              {{ block_settings.column3_header }}
            </th>
          {% endif %}
        </tr>
      </thead>
      <tbody>
        {% for i in (1..8) %}
          {% assign feature_key = 'feature_' | append: i %}
          {% assign feature_text = block_settings[feature_key] %}
          {% assign col1_icon_key = 'col1_icon_' | append: i %}
          {% assign col2_icon_key = 'col2_icon_' | append: i %}
          {% assign col3_icon_key = 'col3_icon_' | append: i %}
          {% assign is_last = false %}

          {% if feature_text != blank %}
            {% assign next = i | plus: 1 %}
            {% assign next_key = 'feature_' | append: next %}
            {% assign next_text = block_settings[next_key] %}
            {% if next_text == blank or i == 8 %}{% assign is_last = true %}{% endif %}

            <tr
              class="comparison-table-3col__row"
              style="border-color: {{ block_settings.row_border_color }};"
            >
              <td
                class="comparison-table-3col__cell comparison-table-3col__cell--feature"
                style="
                  background-color: {{ block_settings.feature_cell_background }};
                  color: {{ block_settings.feature_text_color }};
                  font-size: {{ block_settings.feature_text_size }}px;
                  {% if is_last %}border-radius: 0 0 0 {{ block_settings.border_radius }}px;{% endif %}
                "
              >
                {{ feature_text }}
              </td>
              {% if show_col1 %}
                <td
                  class="comparison-table-3col__cell comparison-table-3col__cell--col1"
                  style="
                    background-color: {{ block_settings.table_background }};
                    border-color: {{ block_settings.row_border_color }};
                    {% if is_last and last_col == 'col1' %}border-radius: 0 0 {{ block_settings.border_radius }}px 0;{% endif %}
                  "
                >
                  {% assign col1_icon = block_settings[col1_icon_key] | default: 'check' %}
                  {% if col1_icon == 'check' %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--check" style="color: {{ block_settings.check_color }};">✓</span>
                  {% elsif col1_icon == 'dash' %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--dash" style="color: {{ block_settings.dash_color }};">—</span>
                  {% else %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--cross" style="color: {{ block_settings.cross_color }};">✗</span>
                  {% endif %}
                </td>
              {% endif %}
              {% if show_col2 %}
                <td
                  class="comparison-table-3col__cell comparison-table-3col__cell--col2"
                  style="
                    background-color: {{ block_settings.table_background }};
                    border-color: {{ block_settings.row_border_color }};
                    {% if is_last and last_col == 'col2' %}border-radius: 0 0 {{ block_settings.border_radius }}px 0;{% endif %}
                  "
                >
                  {% assign col2_icon = block_settings[col2_icon_key] | default: 'cross' %}
                  {% if col2_icon == 'check' %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--check" style="color: {{ block_settings.check_color }};">✓</span>
                  {% elsif col2_icon == 'dash' %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--dash" style="color: {{ block_settings.dash_color }};">—</span>
                  {% else %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--cross" style="color: {{ block_settings.cross_color }};">✗</span>
                  {% endif %}
                </td>
              {% endif %}
              {% if show_col3 %}
                <td
                  class="comparison-table-3col__cell comparison-table-3col__cell--col3"
                  style="
                    background-color: {{ block_settings.table_background }};
                    border-color: {{ block_settings.row_border_color }};
                    {% if is_last %}border-radius: 0 0 {{ block_settings.border_radius }}px 0;{% endif %}
                  "
                >
                  {% assign col3_icon = block_settings[col3_icon_key] | default: 'cross' %}
                  {% if col3_icon == 'check' %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--check" style="color: {{ block_settings.check_color }};">✓</span>
                  {% elsif col3_icon == 'dash' %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--dash" style="color: {{ block_settings.dash_color }};">—</span>
                  {% else %}
                    <span class="comparison-table-3col__icon comparison-table-3col__icon--cross" style="color: {{ block_settings.cross_color }};">✗</span>
                  {% endif %}
                </td>
              {% endif %}
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<style>
  @media screen and (max-width: 749px) {
    .comparison-table-3col--{{ block.id }} .comparison-table-3col__header-cell {
      font-size: {{ block_settings.mobile_header_size }}px !important;
    }
    .comparison-table-3col--{{ block.id }} .comparison-table-3col__cell--feature {
      font-size: {{ block_settings.mobile_feature_size }}px !important;
    }
    .comparison-table-3col--{{ block.id }} .comparison-table-3col__icon {
      font-size: {{ block_settings.mobile_icon_size }}px !important;
    }
  }
</style>

{% stylesheet %}
  .comparison-table-3col {
    width: 100%;
  }

  .comparison-table-3col__wrapper {
    width: 100%;
    overflow: hidden;
  }

  .comparison-table-3col__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .comparison-table-3col__header-row {
    border: none;
  }

  .comparison-table-3col__header-cell {
    padding: 1rem 1.25rem;
    text-align: center;
    border: none;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .comparison-table-3col__header-cell--empty {
    width: 40%;
  }

  .comparison-table-3col__header-cell--col1,
  .comparison-table-3col__header-cell--col2,
  .comparison-table-3col__header-cell--col3 {
    width: 20%;
  }

  .comparison-table-3col__header-image {
    max-width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .comparison-table-3col__row {
    border-top: 1px solid;
  }

  .comparison-table-3col__cell {
    padding: 0.875rem 1rem;
    text-align: center;
    vertical-align: middle;
    border-left: 1px solid;
  }

  .comparison-table-3col__cell--feature {
    text-align: center;
    width: 40%;
    border-left: none;
    font-weight: 600;
  }

  .comparison-table-3col__cell--col1,
  .comparison-table-3col__cell--col2,
  .comparison-table-3col__cell--col3 {
    width: 20%;
  }

  .comparison-table-3col__icon {
    font-size: 1.25rem;
    font-weight: bold;
    display: inline-block;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .comparison-table-3col__header-cell,
    .comparison-table-3col__cell {
      padding: 0.625rem 0.5rem;
      font-size: 0.8125rem;
    }

    .comparison-table-3col__icon {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

