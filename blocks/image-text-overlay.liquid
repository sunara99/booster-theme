

{% liquid
  assign block_settings = block.settings
  assign overlay_heading_stripped = block_settings.overlay_heading | strip_html | strip
  assign overlay_text_stripped = block_settings.overlay_text | strip_html | strip
  assign has_overlay_button = false
  if block_settings.overlay_button_label != blank and block_settings.overlay_button_link != blank
    assign has_overlay_button = true
  endif
  assign has_overlay = false
  if overlay_heading_stripped != blank or overlay_text_stripped != blank or has_overlay_button
    assign has_overlay = true
  endif
  assign split_card_link_from_overlay_button = false
  if block_settings.link != blank and has_overlay_button
    assign split_card_link_from_overlay_button = true
  endif
  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif

  assign overlay_heading_font_size = block_settings.overlay_heading_font_size | default: 28
  assign overlay_heading_min = overlay_heading_font_size | times: 58 | divided_by: 100
  if overlay_heading_min < 12
    assign overlay_heading_min = 12
  endif
%}

{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }}{% if has_overlay %} image-block--has-overlay{% endif %} spacing-style size-style
{% endcapture %}

{% capture style %}
  --ratio: {{ ratio }};
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}

{% capture image_border_style %}
  --ratio: {{ ratio }};
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
%}

{% capture overlay_layer %}
  {%- if has_overlay -%}
    <div
      class="image-block__text-overlay image-block__text-overlay--{{ block_settings.overlay_position | default: 'middle-center' }}"
      style="
        --image-block-overlay-heading-color: {{ block_settings.overlay_heading_color }};
        --image-block-overlay-text-color: {{ block_settings.overlay_text_color }};
        --image-block-overlay-inner-padding: {{ block_settings.overlay_inner_padding | default: 16 }}px;
        --image-block-overlay-heading-min: {{ overlay_heading_min }}px;
        --image-block-overlay-heading-max: {{ overlay_heading_font_size }}px;
        --image-block-overlay-text-font-size: {{ block_settings.overlay_text_font_size | default: 16 }}px;
      "
    >
      {%- if block_settings.overlay_scrim_opacity > 0 -%}
        <div
          class="image-block__text-overlay-scrim"
          style="opacity: {{ block_settings.overlay_scrim_opacity | divided_by: 100.0 }};"
          aria-hidden="true"
        ></div>
      {%- endif -%}
      <div class="image-block__text-overlay-inner text-{{ block_settings.overlay_text_alignment | default: 'center' }}">
        {%- if overlay_heading_stripped != blank -%}
          <div class="image-block__overlay-heading">{{ block_settings.overlay_heading }}</div>
        {%- endif -%}
        {%- if overlay_text_stripped != blank -%}
          <div class="image-block__overlay-text rte">{{ block_settings.overlay_text }}</div>
        {%- endif -%}
        {%- if has_overlay_button -%}
          <div class="image-block__overlay-actions">
            <a
              href="{{ block_settings.overlay_button_link }}"
              class="{{ block_settings.overlay_button_style | default: 'button' }} image-block__overlay-button"
              {%- if block_settings.overlay_button_open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{- block_settings.overlay_button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{% endcapture %}

{% capture image %}
  {%- if block_settings.image -%}
    {{
      block_settings.image
      | image_url: width: 3840
      | image_tag:
        width: block_settings.image.width,
        widths: widths,
        height: block_settings.image.height,
        class: 'image-block__image border-style',
        style: image_border_style,
        sizes: sizes
    }}
  {%- else -%}
    <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'hero__image' }}
    </div>
  {%- endif -%}
{% endcapture %}

{% capture linked_image_inner %}
  {% if block_settings.link_icon != 'none' %}
    <span class="image-block__link-wrapper">
      {{ image }}
      <span class="image-block__link-icon{% if block_settings.link_icon_show_background %} image-block__link-icon--has-bg{% endif %}" aria-hidden="true" style="--link-icon-overlay-opacity: {{ block_settings.link_icon_overlay_opacity | default: 35 | divided_by: 100.0 }}{% if block_settings.link_icon_show_background and block_settings.link_icon_background_color != blank %}; --link-icon-bg: {{ block_settings.link_icon_background_color }}{% endif %}{% if block_settings.link_icon_color != blank %}; --link-icon-color: {{ block_settings.link_icon_color }}{% endif %}">
        {%- render 'icon-or-image',
          icon: block_settings.link_icon_type | default: 'arrow',
          width: 48,
          class_name: 'image-block__link-icon-svg'
        -%}
      </span>
    </span>
  {% else %}
    {{ image }}
  {% endif %}
{% endcapture %}

{% if block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {% if block_settings.ancher_id != blank %}
      <span class="image-block__ancher-target" id="{{ block_settings.ancher_id | strip | escape }}" aria-hidden="true"></span>
    {% endif %}
    {% if has_overlay %}
      <div class="image-block__media-wrap">
        {{ image }}
        {{ overlay_layer }}
      </div>
    {% else %}
      {{ image }}
    {% endif %}
  </div>
{% elsif split_card_link_from_overlay_button %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {% if block_settings.ancher_id != blank %}
      <span class="image-block__ancher-target" id="{{ block_settings.ancher_id | strip | escape }}" aria-hidden="true"></span>
    {% endif %}
    <div class="image-block__media-wrap">
      <a
        href="{{ block_settings.link }}"
        class="image-block__media-link{% if block_settings.link_icon != 'none' %} image-block--link-icon-{{ block_settings.link_icon }}{% endif %}"
      >
        {{ linked_image_inner }}
      </a>
      {{ overlay_layer }}
    </div>
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}{% if block_settings.link_icon != 'none' %} image-block--link-icon-{{ block_settings.link_icon }}{% endif %}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {% if block_settings.ancher_id != blank %}
      <span class="image-block__ancher-target" id="{{ block_settings.ancher_id | strip | escape }}" aria-hidden="true"></span>
    {% endif %}
    {% if has_overlay %}
      <div class="image-block__media-wrap">
        {{ linked_image_inner }}
        {{ overlay_layer }}
      </div>
    {% else %}
      {{ linked_image_inner }}
    {% endif %}
  </a>
{% endif %}

{% stylesheet %}
  .placeholder-image {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  placeholder-image img {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ratio);
  }

  .image-block {
    display: flex;

    /* When the image is nested in a group, section, etc, respect the parent's horizontal alignment */
    justify-content: var(--horizontal-alignment, 'inline-start');
  }
  .image-block svg{
    fill: var(--color-foreground);
  }

  .image-block__ancher-target {
    flex: 0 0 0;
    width: 0;
    min-width: 0;
    height: 0;
    overflow: hidden;
    scroll-margin-top: calc(var(--header-group-height, 0px) + var(--scroll-margin, 12px));
    pointer-events: none;
    align-self: flex-start;
  }

  .image-block--height-fill .image-block__image,
  .image-block--height-fill .image-block__link-wrapper,
  .image-block--height-fill .image-block__media-link {
    height: 100%;
  }

  .image-block__media-link {
    display: block;
    width: 100%;
    position: relative;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    align-self: stretch;
  }

  .image-block__image {
    object-fit: cover;
    aspect-ratio: var(--ratio);
  }

  .image-block__media-wrap {
    position: relative;
    width: 100%;
    display: block;
  }

  .image-block__media-wrap .image-block__image,
  .image-block__media-wrap .placeholder-image {
    width: 100%;
  }

  .image-block--height-fill.image-block--has-overlay .image-block__media-wrap {
    height: 100%;
    align-self: stretch;
  }

  .image-block__text-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    padding: var(--image-block-overlay-inner-padding, var(--padding-md));
    pointer-events: none;
  }

  .image-block__text-overlay-scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgb(0 0 0);
    pointer-events: none;
  }

  .image-block__text-overlay-inner {
    position: relative;
    z-index: 1;
    max-width: min(42rem, 100%);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    pointer-events: auto;
  }

  .image-block__overlay-heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(
      var(--image-block-overlay-heading-min, 1.25rem),
      2.75vw,
      var(--image-block-overlay-heading-max, 2rem)
    );
    font-weight: 600;
    line-height: 1.15;
    color: var(--image-block-overlay-heading-color);
  }

  .image-block__overlay-text {
    margin: 0;
    font-size: var(--image-block-overlay-text-font-size, var(--font-size--body-md));
    line-height: var(--line-height--body-normal);
    color: var(--image-block-overlay-text-color);
  }

  .image-block__overlay-text.rte :is(p, li, ul, ol) {
    font-size: inherit;
  }

  .image-block__overlay-text.rte a {
    color: inherit;
    text-decoration: underline;
  }

  .image-block__overlay-text.rte > *:first-child {
    margin-block-start: 0;
  }

  .image-block__overlay-text.rte > *:last-child {
    margin-block-end: 0;
  }

  .image-block__overlay-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
    width: 100%;
    margin: 0;
  }

  .text-left .image-block__overlay-actions {
    justify-content: flex-start;
  }

  .text-center .image-block__overlay-actions {
    justify-content: center;
  }

  .text-right .image-block__overlay-actions {
    justify-content: flex-end;
  }

  .image-block__overlay-actions .button,
  .image-block__overlay-actions .button-secondary {
    margin: 0;
  }

  .image-block__overlay-button.link {
    color: var(--image-block-overlay-text-color, currentcolor);
  }

  .image-block__text-overlay--top-left {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .image-block__text-overlay--top-center {
    align-items: flex-start;
    justify-content: center;
  }

  .image-block__text-overlay--top-right {
    align-items: flex-start;
    justify-content: flex-end;
  }

  .image-block__text-overlay--middle-left {
    align-items: center;
    justify-content: flex-start;
  }

  .image-block__text-overlay--middle-center {
    align-items: center;
    justify-content: center;
  }

  .image-block__text-overlay--middle-right {
    align-items: center;
    justify-content: flex-end;
  }

  .image-block__text-overlay--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
  }

  .image-block__text-overlay--bottom-center {
    align-items: flex-end;
    justify-content: center;
  }

  .image-block__text-overlay--bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
  }

  .image-block__link-wrapper {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
  }

  .image-block__link-icon {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: var(--link-icon-color, rgb(var(--color-foreground)));
    background: rgba(0, 0, 0, var(--link-icon-overlay-opacity, 0.35));
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .image-block__link-icon svg {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    fill: var(--link-icon-color, rgb(var(--color-foreground)));
  }

  .image-block__link-icon--has-bg::before {
    content: '';
    position: absolute;
    inset: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    background: var(--link-icon-bg, #F5E6C8);
    border-radius: 2px;
    z-index: -1;
  }

  .image-block--link-icon-on_hover:hover .image-block__link-icon,
  .image-block--link-icon-on_hover:focus-visible .image-block__link-icon {
    opacity: 1;
  }

  .image-block--link-icon-always .image-block__link-icon {
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
