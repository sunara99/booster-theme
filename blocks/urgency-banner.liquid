      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "t:sections.urgency-banner.name",
      "category": "t:categories.product",
      "settings": {
        "date_mode": "dynamic",
        "days_from_today": 4,
        "date_format": "%B %d",
        "arrival_date": "February 12",
