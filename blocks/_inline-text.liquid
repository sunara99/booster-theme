      "id": "custom_gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to right",
          "label": "t:options.right"
        },
        {
          "value": "to left",
          "label": "t:options.left"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        },
        {
          "value": "to top",
          "label": "t:options.up"
        }
      ],
      "default": "to right",
      "visible_if": "{{ block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "custom_color_bold",
      "label": "t:sections.lumin_general.bold_text_color",
      "default": "#000000",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
