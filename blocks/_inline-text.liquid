          "label": "Text color"
        },
        {
          "value": "gradient",
          "label": "Text gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "t:sections.lumin_general.text_color",
      "default": "#000000",
      "visible_if": "{{ block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'solid' }}"
