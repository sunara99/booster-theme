
{% assign block_id = block.id | replace: '_', '' | downcase %}

{% liquid
  if block.settings.aspect_ratio == 'auto'
    assign aspect_ratio_value = 'auto'
  elsif block.settings.aspect_ratio == 'square'
    assign aspect_ratio_value = '1 / 1'
  elsif block.settings.aspect_ratio == 'portrait'
    assign aspect_ratio_value = '3 / 4'
  elsif block.settings.aspect_ratio == 'widescreen'
    assign aspect_ratio_value = '16 / 9'
  else
    assign aspect_ratio_value = '16 / 9'
  endif
%}

{% style %}
  .lumin-video-slider-{{ block_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    cursor: grab;
    user-select: none;
    {% if block.settings.background %}
      background-color: {{ block.settings.background_color | default: '#00000026' }};
      border-radius: {{ block.settings.corner_radius }}px;
    {% endif %}
  }

  .lumin-video-slider-{{ block_id }}:active {
    cursor: grabbing;
  }

  .lumin-video-slider-{{ block_id }}[data-dragging] {
    cursor: grabbing;
  }

  .lumin-video-slider-container-{{ block_id }} {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .lumin-video-slider-track-{{ block_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.4s ease;
    min-width: 0;
  }

  .lumin-video-slider-slide-{{ block_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.slides_per_view_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_desktop }});
    position: relative;
    background-color: {{ block.settings.video_background_color }};
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .lumin-video-slider-slide-{{ block_id }}.hidden {
    display: none;
  }

  .lumin-video-slider-slide-{{ block_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lumin-video-slider-slide-{{ block_id }} iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }

  .lumin-video-slider-slide-{{ block_id }} .lumin-video-wrapper-{{ block_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.aspect_ratio == 'auto' %}
      height: auto;
    {% else %}
      aspect-ratio: {{ aspect_ratio_value }};
    {% endif %}
  }

  .lumin-video-slider-slide-{{ block_id }} .lumin-video-wrapper-{{ block_id }}.playing {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="white" stroke="black" stroke-width="1"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>') 16 16, pointer;
  }

  .lumin-video-slider-slide-{{ block_id }} .lumin-video-placeholder-{{ block_id }} {
    width: 100%;
    {% if block.settings.aspect_ratio == 'auto' %}
      aspect-ratio: 16 / 9;
    {% else %}
      aspect-ratio: {{ aspect_ratio_value }};
    {% endif %}
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .lumin-video-slider-slide-{{ block_id }} .lumin-video-placeholder-{{ block_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .lumin-video-empty-state-{{ block_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .lumin-video-play-button-{{ block_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.3s ease;
    opacity: {{ block.settings.play_button_opacity | divided_by: 100.0 }};
  }

  .lumin-video-play-button-{{ block_id }}:hover {
    background-color: {{ block.settings.play_button_hover_color }};
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }

  .lumin-video-play-button-{{ block_id }}.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .lumin-video-play-button-{{ block_id }} .icon-play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .lumin-video-play-button-{{ block_id }} .icon-play svg {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    color: {{ block.settings.play_button_icon_color }};
  }

  .lumin-video-mute-button-{{ block_id }} {
    position: absolute;
    top: {{ block.settings.mute_button_offset }}px;
    right: {{ block.settings.mute_button_offset }}px;
    width: {{ block.settings.mute_button_size }}px;
    height: {{ block.settings.mute_button_size }}px;
    background-color: {{ block.settings.mute_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: opacity 0.3s ease, background-color 0.3s ease;
    opacity: {{ block.settings.mute_button_opacity | divided_by: 100.0 }};
  }

  .lumin-video-mute-button-{{ block_id }}:hover {
    background-color: {{ block.settings.mute_button_hover_color }};
    opacity: 1;
  }

  .lumin-video-mute-button-{{ block_id }} svg {
    width: calc({{ block.settings.mute_button_size }}px * 0.5);
    height: calc({{ block.settings.mute_button_size }}px * 0.5);
    fill: {{ block.settings.mute_button_icon_color }};
  }

  .lumin-video-slider-nav-{{ block_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.3s ease, background-color 0.3s ease;
    opacity: {{ block.settings.nav_button_opacity | divided_by: 100.0 }};
  }

  .lumin-video-slider-nav-{{ block_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    opacity: 1;
  }

  .lumin-video-slider-nav-{{ block_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .lumin-video-slider-nav-{{ block_id }}.lumin-video-slider-prev-{{ block_id }} {
    left: {{ block.settings.nav_button_offset }}px;
  }

  .lumin-video-slider-nav-{{ block_id }}.lumin-video-slider-next-{{ block_id }} {
    right: {{ block.settings.nav_button_offset }}px;
  }

  .lumin-video-slider-nav-{{ block_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.5);
    height: calc({{ block.settings.nav_button_size }}px * 0.5);
  }

  .lumin-video-slider-dots-{{ block_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: {{ block.settings.dots_margin_top }}px;
    height: calc({{ block.settings.dot_size }}px + 2px);
  }

  .lumin-video-slider-dot-{{ block_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
    padding: 0;
  }

  .lumin-video-slider-dot-{{ block_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  @media screen and (max-width: 749px) {
    .lumin-video-slider-slide-{{ block_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.slides_per_view_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_mobile }});
    }

    .lumin-video-slider-nav-{{ block_id }} {
      width: calc({{ block.settings.nav_button_size }}px * 0.8);
      height: calc({{ block.settings.nav_button_size }}px * 0.8);
    }

    .lumin-video-slider-nav-{{ block_id }}.lumin-video-slider-prev-{{ block_id }} {
      left: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }

    .lumin-video-slider-nav-{{ block_id }}.lumin-video-slider-next-{{ block_id }} {
      right: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }

    .lumin-video-play-button-{{ block_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.8);
      height: calc({{ block.settings.play_button_size }}px * 0.8);
    }

    .lumin-video-mute-button-{{ block_id }} {
      width: calc({{ block.settings.mute_button_size }}px * 0.8);
      height: calc({{ block.settings.mute_button_size }}px * 0.8);
      top: calc({{ block.settings.mute_button_offset }}px * 0.5);
      right: calc({{ block.settings.mute_button_offset }}px * 0.5);
    }
  }
{% endstyle %}

<video-slider-{{ block_id }}
  class="lumin-video-slider-{{ block_id }} spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
  data-slides-desktop="{{ block.settings.slides_per_view_desktop }}"
  data-slides-mobile="{{ block.settings.slides_per_view_mobile }}"
  data-loop="{{ block.settings.loop }}"
  data-video-autoplay="{{ block.settings.video_autoplay }}"
>
  <div class="lumin-video-slider-container-{{ block_id }}">
    <div class="lumin-video-slider-track-{{ block_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign video_url_key = 'video_url_' | append: i
          assign video_shopify_key = 'video_shopify_' | append: i
          assign video_enabled_key = 'video_enabled_' | append: i
          assign video_url = block.settings[video_url_key]
          assign video_shopify = block.settings[video_shopify_key]
          assign video_enabled = block.settings[video_enabled_key]
        %}
        
        <div class="lumin-video-slider-slide-{{ block_id }} {% unless video_enabled %}hidden{% endunless %}" data-slide-index="{{ forloop.index0 }}">
          {% if video_shopify %}
            <div class="lumin-video-wrapper-{{ block_id }}" data-video-type="shopify">
              {{
                video_shopify
                | video_tag:
                  image_size: '1100x',
                  controls: false,
                  muted: true,
                  loop: block.settings.loop_videos,
                  autoplay: false
              }}
              {% unless block.settings.video_autoplay %}
                <button class="lumin-video-play-button-{{ block_id }}" type="button" aria-label="{{ 'accessibility.play_video' | t }}">
                  <span class="icon-play">
                    <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
                    {{- 'icon-play.svg' | inline_asset_content -}}
                  </span>
                </button>
              {% endunless %}
              <button class="lumin-video-mute-button-{{ block_id }}" aria-label="Toggle mute">
                <svg class="lumin-mute-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="display: none;">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
                <svg class="lumin-unmute-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                </svg>
              </button>
            </div>
          {% elsif video_url %}
            <div class="lumin-video-wrapper-{{ block_id }}" data-video-type="external">
              {% if video_url.type == 'youtube' %}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_url.id }}?controls=0&mute=1&loop={{ block.settings.loop_videos | default: 0 }}&playlist={{ video_url.id }}&enablejsapi=1"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% elsif video_url.type == 'vimeo' %}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_url.id }}?controls=0&muted=1&loop={{ block.settings.loop_videos | default: 0 }}"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% endif %}
            </div>
          {% else %}
            <div class="lumin-video-placeholder-{{ block_id }}">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-video' }}
              {% if forloop.first %}
                <div class="lumin-video-empty-state-{{ block_id }}">
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="lumin-video-slider-nav-{{ block_id }} lumin-video-slider-prev-{{ block_id }}"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="lumin-video-slider-nav-{{ block_id }} lumin-video-slider-next-{{ block_id }}"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}
  </div>

  {% if block.settings.show_dots %}
    <div class="lumin-video-slider-dots-{{ block_id }}"></div>
  {% endif %}
</video-slider-{{ block_id }}>

<script>
  (function() {
    class VideoSlider{{ block_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.lastDirection = 'next';
        this.allVideos = [];
      }

      connectedCallback() {
        this.track = this.querySelector('.lumin-video-slider-track-{{ block_id }}');
        this.allSlides = this.querySelectorAll('.lumin-video-slider-slide-{{ block_id }}');
        this.slides = Array.from(this.allSlides).filter(slide => !slide.classList.contains('hidden'));
        this.prevButton = this.querySelector('.lumin-video-slider-prev-{{ block_id }}');
        this.nextButton = this.querySelector('.lumin-video-slider-next-{{ block_id }}');
        this.dotsContainer = this.querySelector('.lumin-video-slider-dots-{{ block_id }}');
        
        this.slidesDesktop = parseInt(this.dataset.slidesDesktop);
        this.slidesMobile = parseInt(this.dataset.slidesMobile);
        this.loop = this.dataset.loop === 'true';
        this.infiniteMode = this.loop;
        this.boundOnTransitionEnd = this.onTransitionEnd.bind(this);
        this.videoAutoplay = this.dataset.videoAutoplay === 'true';
        
        if (this.infiniteMode) {
          this.slides.forEach(slide => {
            const suffixClone = slide.cloneNode(true);
            suffixClone.classList.add('lumin-video-slider-clone-{{ block_id }}');
            this.track.appendChild(suffixClone);
          });
          this.slides.forEach(slide => {
            const prefixClone = slide.cloneNode(true);
            prefixClone.classList.add('lumin-video-slider-clone-{{ block_id }}');
            this.track.insertBefore(prefixClone, this.track.firstChild);
          });
          this.currentIndex = this.slides.length;
          this.track.addEventListener('transitionend', this.boundOnTransitionEnd);
        }
        this.updateSlidesPerView();
        this.setupEventListeners();
        this.setupVideoControls();
        this.createDots();
        this.updateSlider();
      }

      updateSlidesPerView() {
        this.slidesPerView = window.innerWidth <= 749 ? this.slidesMobile : this.slidesDesktop;
        this.maxIndex = this.infiniteMode
          ? this.slides.length * 2
          : Math.max(0, this.slides.length - this.slidesPerView);
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.setupDragScroll();

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.updateSlider();
          this.createDots();
        });
      }

      setupDragScroll() {
        const DRAG_THRESHOLD = 12;
        const MIN_DRAG_DISTANCE = 15;
        let startX = 0;
        let startOffset = 0;
        let moved = false;
        let totalDragDistance = 0;

        const getTrackOffset = () => {
          const style = getComputedStyle(this.track);
          const transform = style.transform;
          if (!transform || transform === 'none') return 0;
          const m = transform.match(/matrix\(([^)]+)\)/);
          if (m) {
            const parts = m[1].split(',').map(parseFloat);
            return parts[4] ?? 0;
          }
          return 0;
        };

        const getBounds = () => {
          const container = this.querySelector('.lumin-video-slider-container-{{ block_id }}');
          const containerWidth = container?.offsetWidth || this.offsetWidth;
          const trackWidth = this.track.scrollWidth;
          const maxOffset = 0;
          const minOffset = -Math.max(0, trackWidth - containerWidth);
          return { maxOffset, minOffset };
        };

        const onPointerDown = (e) => {
          if (e.button !== 0 && e.pointerType === 'mouse') return;
          if (e.target.closest('.lumin-video-play-button-{{ block_id }}') || e.target.closest('.lumin-video-mute-button-{{ block_id }}')) return;
          if (e.target.closest('.lumin-video-slider-nav-{{ block_id }}, .lumin-video-slider-dots-{{ block_id }}')) return;
          if (e.target.closest('.lumin-video-wrapper-{{ block_id }}')) return;
          if (this.slides.length <= 1) return;

          e.preventDefault();
          startX = e.clientX;
          startOffset = getTrackOffset();
          moved = false;
          totalDragDistance = 0;
          this.setPointerCapture(e.pointerId);

          const onPointerMove = (e) => {
            const delta = e.clientX - startX;
            if (!moved && Math.abs(delta) >= DRAG_THRESHOLD) {
              moved = true;
              this.setAttribute('data-dragging', '');
              this.track.style.transition = 'none';
            }
            if (!moved) return;

            const { maxOffset, minOffset } = getBounds();
            const newOffset = Math.min(maxOffset, Math.max(minOffset, startOffset + delta));
            this.track.style.transform = `translateX(${newOffset}px)`;
          };

          const onPointerUp = (e) => {
            this.releasePointerCapture(e.pointerId);
            document.removeEventListener('pointermove', onPointerMove);
            document.removeEventListener('pointerup', onPointerUp);
            document.removeEventListener('pointercancel', onPointerUp);

            totalDragDistance = Math.abs(e.clientX - startX);
            if (!moved || totalDragDistance < MIN_DRAG_DISTANCE) {
              if (moved) {
                this.track.style.transition = '';
                this.removeAttribute('data-dragging');
                this.updateSlider();
              }
              return;
            }

            this._justDragged = true;
            setTimeout(() => { this._justDragged = false; }, 0);
            this.removeAttribute('data-dragging');
            this.track.style.transition = '';

            const firstSlide = this.infiniteMode ? this.track.children[this.slides.length] : this.slides[0];
            const slideWidth = (firstSlide || this.slides[0])?.offsetWidth || 0;
            const gap = {{ block.settings.gap }};
            const step = slideWidth + gap;
            const currentOffset = getTrackOffset();

            if (this.infiniteMode) {
              const totalSlides = this.track.children.length;
              const logicalIndex = Math.round(-currentOffset / step);
              this.currentIndex = Math.max(0, Math.min(totalSlides - 1, logicalIndex));
            } else {
              this.currentIndex = Math.round(-currentOffset / step);
              this.currentIndex = Math.max(0, Math.min(this.maxIndex, this.currentIndex));
            }

            this.updateSlider();
            this.track.style.transition = '';
          };

          document.addEventListener('pointermove', onPointerMove);
          document.addEventListener('pointerup', onPointerUp);
          document.addEventListener('pointercancel', onPointerUp);
        };

        this.addEventListener('pointerdown', onPointerDown);
      }

      muteAllOtherVideos(currentVideo) {
        this.allVideos.forEach((videoData) => {
          if (videoData.video !== currentVideo && !videoData.video.muted) {
            videoData.video.muted = true;
            if (videoData.muteIcon && videoData.unmuteIcon) {
              videoData.muteIcon.style.display = 'block';
              videoData.unmuteIcon.style.display = 'none';
            }
          }
        });
      }

      setupVideoControls() {
        const allSlidesInTrack = this.track.querySelectorAll('.lumin-video-slider-slide-{{ block_id }}');
        allSlidesInTrack.forEach((slide) => {
          const wrapper = slide.querySelector('.lumin-video-wrapper-{{ block_id }}');
          if (!wrapper) return;

          const videoType = wrapper.dataset.videoType;
          
          if (videoType === 'shopify') {
            const video = wrapper.querySelector('video');
            const playButton = wrapper.querySelector('.lumin-video-play-button-{{ block_id }}');
            const muteButton = wrapper.querySelector('.lumin-video-mute-button-{{ block_id }}');
            const muteIcon = muteButton?.querySelector('.lumin-mute-icon-{{ block_id }}');
            const unmuteIcon = muteButton?.querySelector('.lumin-unmute-icon-{{ block_id }}');

            if (!video) return;

            this.allVideos.push({
              video: video,
              muteIcon: muteIcon,
              unmuteIcon: unmuteIcon
            });

            if (this.videoAutoplay) {
              video.play().catch(() => {});
              wrapper.classList.add('playing');
            }

            const updateMuteIcons = (muted) => {
              if (muteIcon && unmuteIcon) {
                if (muted) {
                  muteIcon.style.display = 'block';
                  unmuteIcon.style.display = 'none';
                } else {
                  muteIcon.style.display = 'none';
                  unmuteIcon.style.display = 'block';
                }
              }
            };

            if (playButton) {
              playButton.addEventListener('click', () => {
                this.muteAllOtherVideos(video);
                video.muted = false;
                updateMuteIcons(false);
                video.play();
                playButton.classList.add('hidden');
                wrapper.classList.add('playing');
              });
            }

            wrapper.addEventListener('click', (e) => {
              if (this._justDragged) return;
              if (e.target.closest('.lumin-video-play-button-{{ block_id }}') || e.target.closest('.lumin-video-mute-button-{{ block_id }}')) {
                return;
              }
              
              if (!video.paused) {
                if (video.muted) {
                  this.muteAllOtherVideos(video);
                  video.muted = false;
                  updateMuteIcons(false);
                } else {
                  video.pause();
                  wrapper.classList.remove('playing');
                  if (playButton) {
                    playButton.classList.remove('hidden');
                  }
                }
              } else {
                this.muteAllOtherVideos(video);
                video.muted = false;
                updateMuteIcons(false);
                video.play();
                wrapper.classList.add('playing');
                if (playButton) {
                  playButton.classList.add('hidden');
                }
              }
            });

            if (muteButton && muteIcon && unmuteIcon) {
              muteButton.addEventListener('click', (e) => {
                e.stopPropagation();
                
                if (video.muted) {
                  this.muteAllOtherVideos(video);
                  video.muted = false;
                  muteIcon.style.display = 'none';
                  unmuteIcon.style.display = 'block';
                } else {
                  video.muted = true;
                  muteIcon.style.display = 'block';
                  unmuteIcon.style.display = 'none';
                }
              });
            }
          }
        });
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        const totalDots = this.infiniteMode ? this.slides.length : this.maxIndex + 1;
        
        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'lumin-video-slider-dot-{{ block_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
        
        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;
        
        const dots = this.dotsContainer.querySelectorAll('.lumin-video-slider-dot-{{ block_id }}');
        const effectiveIndex = this.infiniteMode ? this.currentIndex % this.slides.length : this.currentIndex;
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === effectiveIndex);
        });
      }

      updateSlider() {
        if (this.slides.length === 0) return;
        
        const firstSlide = this.infiniteMode ? this.track.children[this.slides.length] : this.slides[0];
        const slideWidth = (firstSlide || this.slides[0]).offsetWidth;
        const gap = {{ block.settings.gap }};
        const offset = -(this.currentIndex * (slideWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;
        
        if (this.prevButton) {
          const atStart = this.infiniteMode ? this.currentIndex === this.slides.length : this.currentIndex === 0;
          this.prevButton.disabled = !this.loop && atStart;
        }
        
        if (this.nextButton) {
          this.nextButton.disabled = !this.loop && this.currentIndex >= this.maxIndex;
        }
        
        this.updateDots();
      }

      prev() {
        this.lastDirection = 'prev';
        if (this.currentIndex > 0) {
          this.currentIndex--;
        } else if (this.loop) {
          this.currentIndex = this.infiniteMode ? this.maxIndex - 1 : this.maxIndex;
        }
        this.updateSlider();
      }

      next() {
        this.lastDirection = 'next';
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
        } else if (this.loop && !this.infiniteMode) {
          this.currentIndex = 0;
        }
        this.updateSlider();
      }

      goToSlide(index) {
        this.lastDirection = index > this.currentIndex ? 'next' : 'prev';
        this.currentIndex = index;
        this.updateSlider();
      }

      onTransitionEnd(e) {
        if (e.propertyName !== 'transform') return;
        if (this.infiniteMode && this.lastDirection === 'next' && this.currentIndex === this.slides.length * 2) {
          this.track.style.transition = 'none';
          this.currentIndex = this.slides.length;
          this.updateSlider();
          this.track.offsetHeight;
          this.track.style.transition = '';
          return;
        }
        if (this.infiniteMode && this.lastDirection === 'prev' && this.currentIndex === 0) {
          this.track.style.transition = 'none';
          this.currentIndex = this.slides.length;
          this.updateSlider();
          this.track.offsetHeight;
          this.track.style.transition = '';
          return;
        }
      }

      disconnectedCallback() {
        if (this.track && this.infiniteMode) {
          this.track.removeEventListener('transitionend', this.boundOnTransitionEnd);
        }
      }
    }

    customElements.define('video-slider-{{ block_id }}', VideoSlider{{ block_id }});
  })();
</script>

