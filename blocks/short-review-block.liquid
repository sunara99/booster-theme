
<div
  id="short-review-block-{{ block.id }}"
  style="
    margin-bottom:{{ block.settings.margin_bottom }}px;margin-top: {{ block.settings.margin_top }}px;
    --star-min-background: {{ block.settings.lrw_star_color }};
    --star-color:#eee;
    --star-size-short: {{ block.settings.star_size }};
    --short-rating: {{ block.settings.star_rating }};
    --short-star-color: {{ block.settings.lrw_star_color }};
    --short-star-inactive: {{ block.settings.lrw_star_color_disable }};
  "
  {{ block.shopify_attributes }}
>
  {% assign star_size_short = block.settings.star_size %}
  {% assign rating_short = block.settings.star_rating %}

  <a
    class="review-link" href="#lmReview"
    style="text-decoration: none; display: flex;margin-top: 0;column-gap: 0px;align-items: center;cursor: pointer;"
  >
    <span style="color: rgba(var(--color-base-accent-2), 1);padding: 0;display:flex;align-items: center;gap: 7px"> 
      {% if block.settings.star_style == 'star' %}
        <span class="star-rating-short" style="zoom: {{ star_size_short }};margin-right: 5px;display: flex;align-items: center;">
          <!-- Replace with dynamic input -->
          {% assign max_stars = 5 %}
          {% assign full_stars = rating_short | floor %}
          {% assign half_star = rating_short | minus: full_stars | times: 2 | round %}
          {% assign remaining_stars = max_stars | minus: full_stars | minus: half_star %}

          <style>
            .star-rating-short .star-short {
              width: 24px;
              height: 24px;
              margin-right: 2px;
              vertical-align: text-bottom;
            }
          </style>

          <!-- Loop to show full stars -->
          {% for i in (1..full_stars) %}
            <svg
              class="star-short full"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="var(--short-star-color)"
            >
              <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.826 1.608 8.144L12 18.896l-7.544 4.38 1.608-8.144L.587 9.306l8.332-1.151z"/>
            </svg>
          {% endfor %}

          <!-- Show half star if needed -->
          {% if half_star == 1 %}
            <svg
              class="star-short half"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="24"
              height="24"
            >
              <defs>
                <linearGradient id="halfStarGradientShort-{{ block.id }}">
                  <stop offset="50%" stop-color="var(--short-star-color)"/>
                  <stop offset="50%" stop-color="var(--short-star-inactive)"/>
                </linearGradient>
              </defs>
              <path fill="url(#halfStarGradientShort-{{ block.id }})" d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.826 1.608 8.144L12 18.896l-7.544 4.38 1.608-8.144L.587 9.306l8.332-1.151z"/>
            </svg>
          {% endif %}

          <!-- Loop to show empty stars -->
          {% for i in (1..remaining_stars) %}
            <svg
              class="star-short empty"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="var(--short-star-inactive)"
            >
              <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.826 1.608 8.144L12 18.896l-7.544 4.38 1.608-8.144L.587 9.306l8.332-1.151z"/>
            </svg>
          {% endfor %}
        </span>
      {% endif %}
      {% if block.settings.star_style == 'star_bg' %}
        <span class="rating-mn" data-rating="{{ rating_short }}" style="zoom: {{ star_size_short }};margin-right: 5px;">
          {% render 'short-review-2' %}
        </span>
      {% endif %}
      {% if block.settings.star_style == 'star_bg_2' %}
        <span class="rating-mn" data-rating="{{ rating_short }}" style="zoom: {{ star_size_short }};margin-right: 5px;">
          {% render 'short-review-3' %}
        </span>
      {% endif %}

      <span style="color:{{ block.settings.lrw_color }}; font-size: {{ block.settings.text_size }}px; text-underline-offset: 1.5px;">
        {{- block.settings.lrw_text -}}
      </span>
    </span>

    {%- if block.settings.show_happy_customers_tag and block.settings.happy_customers_text != blank -%}
      <span
        class="happy-customers-tag-short"
        style="
          {% if block.settings.happy_customers_bg_color != blank %}background-color: {{ block.settings.happy_customers_bg_color }};{% endif %}
          {% if block.settings.happy_customers_text_color != blank %}color: {{ block.settings.happy_customers_text_color }};{% endif %}
          {% if block.settings.happy_customers_border_radius > 0 %}border-radius: {{ block.settings.happy_customers_border_radius }}px;{% endif %}
          {% if block.settings.happy_customers_text_size > 0 %}font-size: {{ block.settings.happy_customers_text_size }}px;{% endif %}
          padding: {{ block.settings.happy_customers_padding_top }}px {{ block.settings.happy_customers_padding_right }}px {{ block.settings.happy_customers_padding_bottom }}px {{ block.settings.happy_customers_padding_left }}px;
        "
      >
        {{ block.settings.happy_customers_text }}
      </span>
    {%- endif -%}
  </a>
</div>
                <script type="text/javascript">
  $(document).ready(function(){
    $(".review-link").click(function(){
      $('html,body').animate({
        scrollTop: $('#lmReview').offset().top
      }, 500);

      return false;
    });
  })
</script>

<style>
  .happy-customers-tag-short {
    display: inline-block;
    white-space: nowrap;
    line-height: 1.4;
    margin-left: 8px;
  }
</style>

{% schema %}

{
      "name": "Lumin Review",
       "settings": [
         {
          "type": "inline_richtext",
          "id": "lrw_text",
          "label": "t:sections.lumin-review.rating_text",
          "default": "4.8 From 136 Reviews"
        },
         {
          "type": "range",
          "id": "text_size",
          "label": "t:sections.lumin-review.review_text_size",
          "min":       6,
          "max":        30,
          "step":       1,
          "default": 14
          },
         {
        "type": "header",
        "content": "t:sections.lumin-review.stars"
      },
   {
      "type": "select",
      "id": "star_style",
      "label": "t:sections.lumin-review.star_style",
      "options": [
        {
          "value": "star",
          "label": "t:sections.lumin-review.stars"
        },
        {
          "value": "star_bg",
          "label": "t:sections.lumin-review.colors"
        },
        {
          "value": "star_bg_2",
          "label": "t:sections.lumin-review.star_style_crisp"
        }
      ],
      "default": "star"
    },
         {
    "type":      "range",
    "id":        "star_size",
    "min":       0.3,
    "max":        2,
    "step":       0.1,
    "label":     "t:sections.lumin-review.star_size",
    "default":   0.7
},
            {
    "type":      "range",
    "id":        "star_rating",
    "min":       1,
    "max":        5,
    "step":       0.5,
    "label":     "t:sections.lumin-review.star_rating",
    "default":   4.5
},
         {
        "type": "color",
        "id": "lrw_star_color",
        "label":  "t:sections.lumin-review.star_color",
        "default": "#000000"
      },
          {
        "type": "color",
        "id": "lrw_star_color_disable",
        "label":  "t:sections.lumin-review.disable_star_color",
        "default": "#eee"
      },
         {
        "type": "color",
        "id": "lrw_color",
        "label":  "t:sections.lumin-review.text_color",
        "default": "#000000"
      },
          {
      "type": "range",
      "id": "margin_top",
      "min": -16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "t:sections.lumin-review.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": -16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "t:sections.lumin-review.margin_bottom",
      "default": 0
    },
     {
    "type": "header",
    "content": "t:sections.lumin-review.header_note",
    "info": "t:sections.lumin-review.header_note_info"
     },
     {
      "type": "header",
      "content": "t:sections.lumin-review.happy_customers_tag"
    },
    {
      "type": "checkbox",
      "id": "show_happy_customers_tag",
      "label": "t:sections.lumin-review.show_happy_customers_tag",
      "default": false
    },
    {
      "type": "text",
      "id": "happy_customers_text",
      "label": "t:sections.lumin-review.tag_text",
      "default": "Happy Customers",
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "color",
      "id": "happy_customers_bg_color",
      "label": "t:sections.lumin-review.background_color",
      "default": "#FFE5E5",
      "alpha": true,
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "color",
      "id": "happy_customers_text_color",
      "label": "t:sections.lumin-review.text_color",
      "default": "#DC2626",
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "range",
      "id": "happy_customers_text_size",
      "label": "t:content.text",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "range",
      "id": "happy_customers_border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "range",
      "id": "happy_customers_padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "range",
      "id": "happy_customers_padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "range",
      "id": "happy_customers_padding_left",
      "label": "t:options.left",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    },
    {
      "type": "range",
      "id": "happy_customers_padding_right",
      "label": "t:options.right",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.show_happy_customers_tag }}"
    }
       ],
       "presets": [
    {
      "name": "Lumin Review",
      "category": "t:categories.product"
    }
  ]
    }
{% endschema %}