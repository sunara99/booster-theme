{% assign block_settings = block.settings %}

<div class="swiper-slide" {{ block.shopify_attributes }}>
  <div class="swiper-slide-image" style="position: relative; width: 100%; height: 100%;">
  {% if block_settings.image != blank %}
    {% liquid
      assign image_alt = block_settings.image.alt | default: section.settings.heading
      assign preview_image = block_settings.image
      assign height = preview_image.width | divided_by: preview_image.aspect_ratio | round
      assign media_width_desktop = '100vw'
      assign media_width_mobile = '100vw'
      assign sizes = '(min-width: 1920px) 1920px, (min-width: 1200px) 1200px, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
      assign lazy_sizes = 'auto, ' | append: sizes
      assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      assign loading = 'lazy'
      assign fetchpriority = 'auto'
      assign block_index = section.blocks | find_index: 'id', block.id
      if block_index == 0
        assign loading = 'eager'
        assign fetchpriority = 'high'
        assign sizes = lazy_sizes 
      endif
    %}
    
    <!-- Desktop Image -->
    <div class="swiper-slide-img-desktop{% if block_settings.mobile_image == blank %} swiper-slide-img-fallback{% endif %}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
      {{
        preview_image
        | image_url: width: 3840
        | image_tag: 
          height: height,
          loading: loading,
          fetchpriority: fetchpriority,
          alt: image_alt,
          class: 'swiper-slide-img',
          style: 'object-fit: cover; width: 100%; height: 100%;', 
          sizes: sizes,
          widths: widths
      }}
    </div>
    
    <!-- Mobile Image -->
    {% if block_settings.mobile_image != blank %}
      {% liquid
        assign mobile_image_alt = block_settings.mobile_image.alt | default: section.settings.heading
        assign mobile_preview_image = block_settings.mobile_image
        assign mobile_height = mobile_preview_image.width | divided_by: mobile_preview_image.aspect_ratio | round
      %}
      <div class="swiper-slide-img-mobile" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
        {{
          mobile_preview_image
          | image_url: width: 3840
          | image_tag: 
            height: mobile_height,
            loading: loading,
            fetchpriority: fetchpriority,
            alt: mobile_image_alt,
            class: 'swiper-slide-img',
            style: 'object-fit: cover; width: 100%; height: 100%;',
            sizes: sizes,
            widths: widths
        }}
      </div>
    {% endif %}
    
  {% else %}
    <div class="swiper-slide-placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}
  
  <!-- Theme Blocks -->
  <div class="swiper-slide-content-overlay spacing-style" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2; display: flex; align-items: center; justify-content: center; padding: 3rem; pointer-events: none;">
    <div class="group-block-content layout-panel-flex layout-panel-flex--column" style="pointer-events: auto; width: 100%; max-width: 100%;">
      {% content_for 'blocks' %}
    </div>
  </div>
  
  {% if block_settings.caption != blank %}
    <div class="swiper-slide-caption">
      <p>{{ block_settings.caption }}</p>
    </div>
  {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image Slide",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional image for mobile devices. If not set, desktop image will be used."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Optional caption text for the image"
    }
  ]
}
{% endschema %}
