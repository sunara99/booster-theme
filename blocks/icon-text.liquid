{%- liquid
  assign s = block.settings
  assign icon_block_class = 'icon-text-block__icon icon-text-block-' | append: block.id
  if s.layout == 'column'
    case s.vertical_alignment
      when 'left'
        assign align_value = 'flex-start'
        assign text_align_value = 'left'
      when 'right'
        assign align_value = 'flex-end'
        assign text_align_value = 'right'
      else
        assign align_value = 'center'
        assign text_align_value = 'center'
    endcase
  else
    assign align_value = 'center'
    assign text_align_value = 'left'
  endif
-%}

<div
  class="icon-text-block icon-text-block--{{ block.id }}{% if s.layout == 'column' and s.vertical_on_mobile == false %} icon-text-block--horizontal-on-mobile{% endif %}"
  style="
    --icon-text-block-bg: {{ s.background_color | default: 'transparent' }};
    /*--icon-text-block-text: {{ s.text_color | default: 'rgb(0, 0, 0)' }};*/
    --icon-text-block-gap: {{ s.gap }}px;
    --icon-text-block-direction: {{ s.layout }};
    --icon-text-block-align: {{ align_value }};
    --icon-text-block-text-align: {{ text_align_value }};
    --icon-text-block-radius: {{ s.corner_radius }}px;
    --icon-text-block-padding: {{ s.padding_top }}px {{ s.padding_sides }}px {{ s.padding_bottom }}px;
    {% if s.font_size != blank %}--icon-text-block-font-size: {{ s.font_size }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- if s.link != blank -%}
    <a
      href="{{ s.link }}"
      class="icon-text-block__link"
      {% if s.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
  {%- endif -%}

  <div class="icon-text-block__inner">
    {%- capture icon_content -%}
      {% render 'icon-or-image',
        icon: s.icon,
        image_upload: s.image_upload,
        width: s.icon_width,
        image_corner_radius: s.image_corner_radius,
        class_name: icon_block_class
      %}
    {%- endcapture -%}

    {%- if icon_content != blank -%}
      <div class="icon-text-block__icon-wrap">
        {{ icon_content }}
      </div>
    {%- endif -%}

    {%- if s.text != blank -%}
      <div class="icon-text-block__text">
        {{ s.text }}
      </div>
    {%- endif -%}
  </div>

  {%- if s.link != blank -%}
    </a>
  {%- endif -%}
</div>

<style>
  .icon-text-block--{{ block.id }} {
    background-color: var(--icon-text-block-bg);
    /*color: var(--icon-text-block-text);*/
    border-radius: var(--icon-text-block-radius);
    padding: var(--icon-text-block-padding);
  }

  .icon-text-block__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .icon-text-block__inner {
    display: flex;
    flex-direction: var(--icon-text-block-direction);
    align-items: var(--icon-text-block-align);
    gap: var(--icon-text-block-gap);
  }

  .icon-text-block__icon-wrap {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .icon-text-block--{{ block.id }} .icon-text-block__icon,
  .icon-text-block--{{ block.id }} .icon-text-block__icon-wrap img {
    display: block;
  }

  .icon-text-block__text {
    flex: 1;
    min-width: 0;
    font-size: var(--icon-text-block-font-size, inherit);
    line-height: 1.5;
    margin: 0;
    text-align: var(--icon-text-block-text-align);
  }

  .icon-text-block__text p:first-child {
    margin-top: 0;
  }

  .icon-text-block__text p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .icon-text-block--horizontal-on-mobile .icon-text-block__inner {
      flex-direction: row;
      align-items: center;
    }

    .icon-text-block--horizontal-on-mobile .icon-text-block__text {
      text-align: left;
    }
    .layout-panel-flex--row:not(.mobile-column) {
        flex-wrap: nowrap;
    }
  }
</style>

