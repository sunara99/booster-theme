      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 5
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "t:settings.color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "t:sections.testimonial-slider.author"
    },
    {
      "type": "checkbox",
      "id": "show_author_image",
      "label": "t:sections.testimonial-slider.show_author_image",
