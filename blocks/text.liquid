

{% render 'text', block: block %}

{% schema %}
{
  "name": "t:names.text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.text_truncation"
    },
    {
      "type": "checkbox",
      "id": "enable_text_truncation",
      "label": "t:settings.truncate_with_view_more",
      "default": false,
      "info": "t:settings.truncate_with_view_more_info"
    },
    {
      "type": "range",
      "id": "truncate_lines",
      "label": "t:settings.truncate_lines_before_view_more",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.enable_text_truncation }}"
    },
    {
      "type": "text",
      "id": "truncate_view_more_label",
      "label": "t:settings.view_more_link_text",
      "default": "View more",
      "visible_if": "{{ block.settings.enable_text_truncation }}"
    },
    {
      "type": "text",
      "id": "truncate_view_less_label",
      "label": "t:settings.view_less_link_text",
      "default": "View less",
      "visible_if": "{{ block.settings.enable_text_truncation }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "100%",
          "label": "t:options.fill"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "t:settings.max_width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "normal"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left",
      "visible_if": "{{ block.settings.width == '100%' }}"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "rte",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "rte",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "t:options.accent"
        },
        {
          "value": "custom_font",
          "label": "t:options.custom_font"
        }
      ],
      "default": "var(--font-body--family)",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "font_picker",
      "id": "custom_typography_font",
      "label": "t:settings.custom_typography_font",
      "default": "work_sans_n4",
      "info": "t:info.custom_typography_font",
      "visible_if": "{{ block.settings.type_preset == 'custom' and block.settings.font == 'custom_font' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_bold_typography_font",
      "label": "t:settings.enable_bold_typography_font",
      "default": false,
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "font_picker",
      "id": "bold_typography_font",
      "label": "t:settings.bold_typography_font",
      "default": "work_sans_n7",
      "info": "t:info.bold_italic_typography_font",
      "visible_if": "{{ block.settings.type_preset == 'custom' and block.settings.enable_bold_typography_font }}"
    },
    {
      "type": "checkbox",
      "id": "enable_italic_typography_font",
      "label": "t:settings.enable_italic_typography_font",
      "default": false,
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "font_picker",
      "id": "italic_typography_font",
      "label": "t:settings.italic_typography_font",
      "default": "work_sans_i4",
      "info": "t:info.bold_italic_typography_font",
      "visible_if": "{{ block.settings.type_preset == 'custom' and block.settings.enable_italic_typography_font }}"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        },
        {
          "value": "2rem",
          "label": "32px"
        },
        {
          "value": "2.5rem",
          "label": "40px"
        },
        {
          "value": "3rem",
          "label": "48px"
        },
        {
          "value": "3.5rem",
          "label": "56px"
        },
        {
          "value": "4.5rem",
          "label": "72px"
        },
        {
          "value": "5.5rem",
          "label": "88px"
        },
        {
          "value": "7.5rem",
          "label": "120px"
        },
        {
          "value": "9.5rem",
          "label": "152px"
        },
        {
          "value": "11.5rem",
          "label": "184px"
        }
      ],
      "default": "1rem",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "t:settings.line_height",
      "options": [
        {
          "value": "tight",
          "label": "t:options.tight"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "loose",
          "label": "t:options.loose"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "t:settings.letter_spacing",
      "options": [
        {
          "value": "tight",
          "label": "t:options.tight"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "loose",
          "label": "t:options.loose"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "wrap",
      "label": "t:settings.wrap",
      "options": [
        {
          "value": "pretty",
          "label": "t:options.pretty"
        },
        {
          "value": "balance",
          "label": "t:options.balance"
        },
        {
          "value": "nowrap",
          "label": "t:options.none"
        }
      ],
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Color style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.type_preset != 'rte' }}"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:settings.color",
      "options": [
        {
          "value": "var(--color-foreground)",
          "label": "t:options.text"
        },
        {
          "value": "var(--color-foreground-heading)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--color-primary)",
          "label": "t:options.link"
        }
      ],
      "default": "var(--color-foreground)",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'default' }}"
    },
    {
      "type": "select",
      "id": "custom_color_style",
      "label": "Custom color type",
      "options": [
        {
          "value": "solid",
          "label": "Text color"
        },
        {
          "value": "gradient",
          "label": "Text gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Text color",
      "default": "#000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "custom_gradient_color_start",
      "label": "Gradient start color",
      "default": "#000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "custom_gradient_color_end",
      "label": "Gradient end color",
      "default": "#666666",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'gradient' }}"
    },
    {
      "type": "select",
      "id": "custom_gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to right",
          "label": "t:options.right"
        },
        {
          "value": "to left",
          "label": "t:options.left"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        },
        {
          "value": "to top",
          "label": "t:options.up"
        }
      ],
      "default": "to right",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "custom_color_bold",
      "label": "Bold text color",
      "default": "#000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "custom_color_italic",
      "label": "Italic text color",
      "default": "#000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' and block.settings.custom_color_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "custom_color_underline",
      "label": "t:settings.custom_color_background_link",
      "default": "#000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_color_background_bold",
      "label": "t:settings.custom_color_background_bold",
      "alpha": true,
      "default": "#00000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_color_background_italic",
      "label": "t:settings.custom_color_background_italic",
      "alpha": true,
      "default": "#00000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_color_background_underline",
      "label": "t:settings.custom_color_background_underline",
      "alpha": true,
      "default": "#00000000",
      "visible_if": "{{ block.settings.type_preset != 'rte' and block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "background",
      "label": "t:settings.background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.background }}"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:settings.corner_radius",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 1,
      "visible_if": "{{ block.settings.background }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.group.ancher_link"
    },
    {
      "type": "text",
      "id": "ancher_id",
      "label": "t:sections.group.ancher_id",
      "info": "t:sections.group.ancher_id_info"
    }
  ],
  "presets": [
    {
      "name": "t:names.text",
      "category": "t:categories.basic",
      "settings": {
        "text": "t:html_defaults.make_things_better_extended"
      }
    },
    {
      "name": "t:names.heading",
      "category": "t:categories.basic",
      "settings": {
        "text": "t:html_defaults.new_arrivals_h2"
      }
    }
  ]
}
{% endschema %}
