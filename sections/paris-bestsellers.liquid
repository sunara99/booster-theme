{%- if section.settings.show_section -%}
{%- assign collection = section.settings.collection -%}
{%- assign limit = section.settings.products_to_show | default: 4 -%}

<section
  class="paris-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="paris-bs-title-{{ section.id }}"
>
  <div class="paris-bestsellers">

    <div class="paris-section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="paris-section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="paris-section-header__title" id="paris-bs-title-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="paris-section-header__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="paris-bestsellers__grid">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {%- assign card_product = product -%}
          {%- assign show_vendor = section.settings.show_vendor -%}
          {% render 'paris-product-card', card_product: card_product, show_vendor: show_vendor %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'paris-product-card' %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div style="text-align: center; margin-top: 44px;">
        <a
          href="{{ section.settings.button_link | default: collection.url | default: '/collections/all' }}"
          class="paris-btn paris-btn--outline"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Meilleures ventes",
  "tag": "div",
  "class": "paris-section-wrap",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Afficher la section",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection à afficher"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher le fournisseur",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Les incontournables"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nos meilleures ventes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton — texte",
      "default": "Voir tout"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Bouton — lien"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond de section",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge intérieure haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge intérieure bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Meilleures ventes"
    }
  ]
}
{% endschema %}
