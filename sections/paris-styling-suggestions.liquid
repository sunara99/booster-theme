{%- if section.settings.show_section -%}
<section
  class="paris-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="paris-style-title-{{ section.id }}"
>
  <div class="paris-styling">

    <div class="paris-section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="paris-section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="paris-section-header__title" id="paris-style-title-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="paris-section-header__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="paris-styling__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'suggestion' -%}
          <div class="paris-styling-item" {{ block.shopify_attributes }}>
            <div class="paris-styling-item__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    widths: '350, 500, 700',
                    sizes: '(max-width: 768px) 90vw, 30vw',
                    alt: block.settings.image.alt | default: block.settings.name | escape
                }}
              {%- else -%}
                <div style="background: var(--pf-beige); width: 100%; height: 100%;"></div>
              {%- endif -%}
            </div>

            {%- if block.settings.label != blank -%}
              <span class="paris-styling-item__label">{{ block.settings.label }}</span>
            {%- endif -%}

            {%- if block.settings.product_handle != blank -%}
              {%- assign suggestion_product = all_products[block.settings.product_handle] -%}
              {%- if suggestion_product != nil -%}
                <a href="{{ suggestion_product.url }}" class="paris-styling-item__name">
                  {{ suggestion_product.title }}
                </a>
                <span class="paris-styling-item__price">{{ suggestion_product.price | money }}</span>
              {%- else -%}
                {%- if block.settings.name != blank -%}
                  <span class="paris-styling-item__name">{{ block.settings.name }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- elsif block.settings.name != blank -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="paris-styling-item__name">{{ block.settings.name }}</a>
              {%- else -%}
                <span class="paris-styling-item__name">{{ block.settings.name }}</span>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <span class="paris-styling-item__price">{{ block.settings.price }}</span>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Suggestions de style",
  "tag": "div",
  "class": "paris-section-wrap",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Afficher la section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Style éditorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Complétez votre look"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond de section",
      "default": "#f9f6f1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge intérieure haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge intérieure bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "suggestion",
      "name": "Suggestion",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image éditoriale"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Surtitre (ex: À associer avec)",
          "default": "À associer avec"
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Handle du produit Shopify (optionnel)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom manuel (si pas de handle)",
          "default": "Blazer Parisien"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien manuel"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Prix manuel (ex: 89,00 €)",
          "default": "89,00 €"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Suggestions de style",
      "blocks": [
        { "type": "suggestion", "settings": { "label": "À associer avec", "name": "Blazer Parisien", "price": "89,00 €" } },
        { "type": "suggestion", "settings": { "label": "Accessoire idéal", "name": "Ceinture dorée", "price": "34,00 €" } },
        { "type": "suggestion", "settings": { "label": "Sac de saison",    "name": "Sac en cuir",    "price": "129,00 €" } }
      ]
    }
  ]
}
{% endschema %}
