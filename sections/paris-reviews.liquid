{%- if section.settings.show_section -%}
<section
  class="paris-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="paris-rev-title-{{ section.id }}"
>
  <div class="paris-reviews">

    <div class="paris-section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="paris-section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="paris-section-header__title" id="paris-rev-title-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="paris-section-header__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="paris-reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="paris-review-card" {{ block.shopify_attributes }}>
            <div class="paris-review-card__stars" aria-label="{{ block.settings.rating }} étoiles sur 5">
              {%- assign rating = block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="opacity:0.25;">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if block.settings.text != blank -%}
              <blockquote class="paris-review-card__text">
                "{{ block.settings.text }}"
              </blockquote>
            {%- endif -%}

            <div class="paris-review-card__author">
              <div class="paris-review-card__avatar" aria-hidden="true">
                {%- if block.settings.avatar != blank -%}
                  {%- assign reviewer_alt = block.settings.name | escape -%}
                  {{
                    block.settings.avatar
                    | image_url: width: 76
                    | image_tag: loading: 'lazy', alt: reviewer_alt
                  }}
                {%- else -%}
                  {{ block.settings.name | slice: 0 | upcase }}
                {%- endif -%}
              </div>
              <div>
                <span class="paris-review-card__name">{{ block.settings.name | default: 'Cliente' }}</span>
                {%- if block.settings.location != blank -%}
                  <span class="paris-review-card__location">{{ block.settings.location }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_rating_summary -%}
      <div style="text-align: center; margin-top: 40px; font-family: var(--pf-font-sans); color: var(--pf-taupe); font-size: 13px;">
        {{ section.settings.rating_summary | default: '4,9 / 5 — Plus de 500 avis vérifiés' }}
      </div>
    {%- endif -%}

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Avis clients",
  "tag": "div",
  "class": "paris-section-wrap",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Afficher la section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Témoignages"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce qu'elles disent"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "checkbox",
      "id": "show_rating_summary",
      "label": "Afficher le résumé de notes",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_summary",
      "label": "Texte résumé de notes",
      "default": "4,9 / 5 — Plus de 500 avis vérifiés"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond de section",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge intérieure haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge intérieure bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis client",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte de l'avis",
          "default": "Qualité exceptionnelle, la coupe est parfaite et le tissu est magnifique. Je la recommande à toutes mes amies !"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Prénom et nom",
          "default": "Sophie L."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Ville / Pays",
          "default": "Paris, France"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo de profil (optionnel)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Qualité exceptionnelle, la coupe est parfaite. Je suis conquise par cette marque !",
            "name": "Sophie L.",
            "location": "Paris, France"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Livraison rapide, emballage soigné et robe encore plus belle en vrai. Bravo !",
            "name": "Marie C.",
            "location": "Lyon, France"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Le tissu est d'une douceur incroyable. La taille est fidèle au guide. Très satisfaite.",
            "name": "Camille D.",
            "location": "Bordeaux, France"
          }
        }
      ]
    }
  ]
}
{% endschema %}
