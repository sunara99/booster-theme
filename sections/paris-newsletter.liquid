{%- if section.settings.show_section -%}
<section
  class="paris-section paris-newsletter"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="paris-nl-title-{{ section.id }}"
>
  {%- if section.settings.bg_image != blank -%}
    <div aria-hidden="true" style="position: absolute; inset: 0; overflow: hidden; z-index: 0;">
      {{
        section.settings.bg_image
        | image_url: width: 1600
        | image_tag: loading: 'lazy', alt: '', style: 'width:100%;height:100%;object-fit:cover;opacity:0.12;'
      }}
    </div>
  {%- endif -%}

  <div class="paris-newsletter__inner" style="position: relative; z-index: 1;">
    {%- if section.settings.heading != blank -%}
      <h2
        class="paris-newsletter__heading"
        id="paris-nl-title-{{ section.id }}"
        style="color: {{ section.settings.text_color }};"
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="paris-newsletter__subheading" style="color: {{ section.settings.text_color }};">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    {%- form 'customer', id: 'paris-newsletter-form-{{ section.id }}' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="paris-newsletter__form" role="search">
        <label for="paris-newsletter-email-{{ section.id }}" class="paris-sr-only">
          Adresse e-mail
        </label>
        <input
          type="email"
          name="contact[email]"
          id="paris-newsletter-email-{{ section.id }}"
          class="paris-newsletter__input"
          placeholder="{{ section.settings.input_placeholder | default: 'Votre adresse e-mail' }}"
          required
          autocomplete="email"
          aria-required="true"
        >
        <button type="submit" class="paris-newsletter__submit">
          {{ section.settings.button_label | default: "S'inscrire" }}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="paris-newsletter__success" style="display: block; color: {{ section.settings.text_color }};">
          {{ section.settings.success_message | default: 'Merci pour votre inscription !' }}
        </p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.note != blank -%}
      <p class="paris-newsletter__note" style="color: {{ section.settings.text_color }}; opacity: 0.6;">
        {{ section.settings.note }}
      </p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "class": "paris-section-wrap",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Afficher la section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Rejoignez notre univers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Accédez en avant-première aux nouvelles collections, conseils de style et offres exclusives."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Texte placeholder du champ",
      "default": "Votre adresse e-mail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "S'inscrire"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de confirmation",
      "default": "Merci ! Vous êtes maintenant inscrite."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note légale (optionnel)",
      "default": "Pas de spam, désabonnement en un clic."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Image de fond (optionnel)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#f0ebe3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge intérieure haut",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge intérieure bas",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
