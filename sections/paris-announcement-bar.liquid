{{ 'paris-fashion.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
<div
  class="paris-section paris-announcement-bar"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
  role="region"
  aria-label="Informations"
  id="paris-announcement-bar"
>
  <div class="paris-announcement-bar__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        <div class="paris-announcement-bar__item" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {%- when 'shield' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- when 'return' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
            {%- when 'star' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- when 'tag' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          {%- endcase -%}
          {{ block.settings.text }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_close -%}
    <button
      class="paris-announcement-bar__close"
      aria-label="Fermer l'annonce"
      type="button"
    >
      <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
        <line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.5"/>
        <line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>
  {%- endif -%}
</div>
{%- endif -%}

<script src="{{ 'paris-fashion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bandeau annonce",
  "tag": "div",
  "class": "paris-section-wrap",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Afficher la section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Afficher le bouton fermer",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Élément d'annonce",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Livraison offerte dès 80€"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "none",   "label": "Aucune" },
            { "value": "truck",  "label": "Livraison" },
            { "value": "shield", "label": "Sécurité" },
            { "value": "return", "label": "Retour" },
            { "value": "star",   "label": "Étoile" },
            { "value": "tag",    "label": "Étiquette" }
          ],
          "default": "truck"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau annonce",
      "blocks": [
        { "type": "item", "settings": { "text": "Livraison offerte dès 80€",    "icon": "truck"  } },
        { "type": "item", "settings": { "text": "Retours sous 14 jours",        "icon": "return" } },
        { "type": "item", "settings": { "text": "Paiement 100% sécurisé",       "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
