{%- liquid
  assign section_id = 'swiper-slideshow-' | append: section.id
  assign autoplay_delay = section.settings.autoplay_speed | times: 1000
  
  # Calculate adaptive height based on first slide's media
  assign desktop_aspect_ratio = 1.0
  assign mobile_aspect_ratio = 1.0
  
  if section.settings.slide_height_adapt and section.blocks.size > 0
    assign first_block = section.blocks.first
    
    # Calculate desktop aspect ratio
    if first_block.type == 'image' and first_block.settings.image != blank
      assign desktop_aspect_ratio = first_block.settings.image.aspect_ratio
    elsif first_block.type == 'video' and first_block.settings.shopify_video != blank
      assign video = first_block.settings.shopify_video
      if video.preview_image != blank
        assign desktop_aspect_ratio = video.preview_image.aspect_ratio
      else
        assign desktop_aspect_ratio = 1.7777777777777777
      endif
    elsif first_block.type == 'content' and first_block.settings.background_image != blank
      assign desktop_aspect_ratio = first_block.settings.background_image.aspect_ratio
    endif
    
    # Calculate mobile aspect ratio
    if first_block.type == 'image' and first_block.settings.image != blank
      if first_block.settings.mobile_image != blank
        assign mobile_aspect_ratio = first_block.settings.mobile_image.aspect_ratio
      else
        assign mobile_aspect_ratio = first_block.settings.image.aspect_ratio
      endif
    elsif first_block.type == 'video' and first_block.settings.shopify_video != blank
      if first_block.settings.mobile_video != blank
        assign mobile_video = first_block.settings.mobile_video 
        if mobile_video.preview_image != blank
          assign mobile_aspect_ratio = mobile_video.preview_image.aspect_ratio
        else
          assign mobile_aspect_ratio = 1.7777777777777777
        endif
      else
        assign video = first_block.settings.shopify_video
        if video.preview_image != blank
          assign mobile_aspect_ratio = video.preview_image.aspect_ratio
        else
          assign mobile_aspect_ratio = 1.7777777777777777
        endif
      endif
    elsif first_block.type == 'content' and first_block.settings.background_image != blank
      if first_block.settings.mobile_background_image != blank
        assign mobile_aspect_ratio = first_block.settings.mobile_background_image.aspect_ratio
      else
        assign mobile_aspect_ratio = first_block.settings.background_image.aspect_ratio
      endif
    endif
  endif
-%}

<style>
  body:has(.header[transparent]) .content-for-layout>.container-background-image:first-child {
    margin-top: calc(var(--header-height) * -1);
}
</style>

<div class="section-background color-{{ section.settings.color_scheme }}" {% if section.settings.ancher_id != blank %}id="{{ section.settings.ancher_id }}"{% endif %}></div>
<div
  class="spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="swiper-slideshow-container"
  style="--swiper-pagination-bullet-width:8px; --swiper-pagination-bullet-height:8px;--swiper-pagination-bullet-active-width: 3rem;--swiper-pagination-bullet-active-transform: scale(1); --swiper-pagination-bullet-border-radius:4px; --swiper-theme-color:{{section.settings.pagination_color}}; --swiper-pagination-bullet-inactive-color: {{section.settings.pagination_color}}; --swiper-pagination-bullet-opacity:1; --swiper-pagination-bullet-inactive-opacity:1;
   --swiper-pagination-bullet-active-opacity:1; --swiper-pagination-bullet-transition:all 0.3s ease;">
    {% if section.settings.heading != blank %}
      <div class="swiper-slideshow-header">
        {% case section.settings.heading_type_preset %}
          {% when 'h1' %}
            <h1 class="swiper-slideshow-title">{{ section.settings.heading }}</h1>
          {% when 'h2' %}
            <h2 class="swiper-slideshow-title">{{ section.settings.heading }}</h2>
          {% when 'h3' %}
            <h3 class="swiper-slideshow-title">{{ section.settings.heading }}</h3>
          {% when 'h4' %}
            <h4 class="swiper-slideshow-title">{{ section.settings.heading }}</h4>
          {% when 'h5' %}
            <h5 class="swiper-slideshow-title">{{ section.settings.heading }}</h5>
          {% when 'h6' %}
            <h6 class="swiper-slideshow-title">{{ section.settings.heading }}</h6>
          {% else %}
            <div class="swiper-slideshow-title">{{ section.settings.heading }}</div>
        {% endcase %}
      </div>
    {% endif %}

    <div 
      class="swiper swiper-slideshow{% if section.settings.slide_height_adapt %} swiper-slideshow--adaptive{% endif %}" 
      id="{{ section_id }}"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-delay="{{ autoplay_delay }}"
      data-loop="{{ section.settings.loop }}"
      data-effect="{{ section.settings.effect }}"
      data-speed="{{ section.settings.speed }}"
      data-space-between="{{ section.settings.space_between }}"
      data-slides-per-view="{% if section.settings.effect == 'slide' %}{{ section.settings.slides_per_view }}{% else %}1{% endif %}"
      data-slides-per-view-mobile="{% if section.settings.effect == 'slide' %}{{ section.settings.slides_per_view_mobile }}{% else %}1{% endif %}"
      data-show-navigation="{{ section.settings.show_navigation }}"
      data-show-pagination="{{ section.settings.show_pagination }}"
      data-pagination-type="{{ section.settings.pagination_type }}"
      {% if section.settings.slide_height_adapt %}
        style="--desktop-aspect-ratio: {{ desktop_aspect_ratio }}; --mobile-aspect-ratio: {{ mobile_aspect_ratio }};"
      {% else %}
        style="height: {{ section.settings.slide_height }}px;"
      {% endif %}
    >
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }} {% if block.type == 'video' %}data-autoplay="{{ block.settings.autoplay_video | json }}" data-show-controls="{{ block.settings.show_controls | json }}"{% endif %}>
            {% case block.type %}
              {% when 'image' %}
                <div class="swiper-slide-image">
                  {% if block.settings.image != blank %}
                    {% liquid
                      assign image_alt = block.settings.image.alt | default: section.settings.heading
                      assign preview_image = block.settings.image
                      assign height = preview_image.width | divided_by: preview_image.aspect_ratio | round
                      assign media_width_desktop = '100vw'
                      assign media_width_mobile = '100vw'
                      assign sizes = '(min-width: 1920px) 1920px, (min-width: 1200px) 1200px, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
                      assign lazy_sizes = 'auto, ' | append: sizes
                      assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                      assign loading = 'lazy'
                      assign fetchpriority = 'auto'
                      if forloop.first
                        assign loading = 'eager'
                        assign fetchpriority = 'high'
                        assign sizes = lazy_sizes 
                      endif
                    %}
                    
                    <!-- Desktop Image -->
                    <div class="swiper-slide-img-desktop{% if block.settings.mobile_image == blank %} swiper-slide-img-fallback{% endif %}">
                      {{
                        preview_image
                        | image_url: width: 3840
                        | image_tag: 
                          height: height,
                          loading: loading,
                          fetchpriority: fetchpriority,
                          alt: image_alt,
                          class: 'swiper-slide-img',
                          style: 'object-fit: cover; width: 100%; height: 100%;',
                          sizes: sizes,
                          widths: widths
                      }}
                    </div>
                    
                    <!-- Mobile Image -->
                    {% if block.settings.mobile_image != blank %}
                      {% liquid
                        assign mobile_image_alt = block.settings.mobile_image.alt | default: section.settings.heading
                        assign mobile_preview_image = block.settings.mobile_image
                        assign mobile_height = mobile_preview_image.width | divided_by: mobile_preview_image.aspect_ratio | round
                      %}
                      <div class="swiper-slide-img-mobile">
                        {{
                          mobile_preview_image
                          | image_url: width: 3840
                          | image_tag: 
                            height: mobile_height,
                            loading: loading,
                            fetchpriority: fetchpriority,
                            alt: mobile_image_alt,
                            class: 'swiper-slide-img',
                            style: 'object-fit: cover; width: 100%; height: 100%;',
                            sizes: sizes,
                            widths: widths
                        }}
                      </div>
                    {% endif %}
                    
                  {% else %}
                    <div class="swiper-slide-placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                  
                  <!-- Content Overlay -->
                  <div class="section spacing-style swiper-slide-content-overlay swiper-slide-content-position-{{ block.settings.desktop_content_position }} swiper-slide-content-alignment-{{ block.settings.content_alignment }} swiper-slide-mobile-position-{{ block.settings.mobile_content_position }} swiper-slide-mobile-alignment-{{ block.settings.mobile_content_alignment }}">
                    {% liquid
                      assign bg_color = block.settings.content_background_color
                      assign bg_opacity = block.settings.content_background_opacity | divided_by: 100.0
                      assign bg_rgba = bg_color | color_modify: 'alpha', bg_opacity
                      assign backdrop_class = ''
                      assign backdrop_max_width_style = ''
                      if block.settings.enable_backdrop_filter
                        assign backdrop_class = 'swiper-slide-content-backdrop'
                      endif
                      if block.settings.backdrop_max_width != blank
                        assign backdrop_max_width_style = 'max-width: ' | append: block.settings.backdrop_max_width | append: 'px;'
                      endif
                      assign animation_class = 'swiper-slide-animate-' | append: block.settings.content_animation
                      assign animation_duration = block.settings.animation_duration | append: 's'
                      assign animation_delay = block.settings.animation_delay | append: 's'
                    %}
                    <div class="swiper-slide-content-inner {{ backdrop_class }} {{ animation_class }}" style="color: {{ block.settings.text_color }}; background-color: {{ bg_rgba }}; {{ backdrop_max_width_style }} --animation-duration: {{ animation_duration }}; --animation-delay: {{ animation_delay }}; --underline-color: {{ block.settings.underline_color }};">
                      
                      {% if block.settings.highlight_text != blank %}
                        <div class="swiper-slide-highlight-text" style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.slide_highlight_text_color }} !important;">
                          {% if block.settings.icon != 'unset' %}
                            <span class="swiper-slide-icon swiper-slide-icon-{{ block.settings.icon }}" style="color: {{ block.settings.icon_color }};"></span>
                          {% endif %}
                          {{ block.settings.highlight_text }}
                        </div>
                      {% endif %}
                      
                      {% if block.settings.subheading != blank %}
                        <div class="swiper-slide-subheading" style="color: {{ block.settings.slide_subheading_color }} !important;">{{ block.settings.subheading }}</div>
                      {% endif %}
                      
                      {% if block.settings.heading != blank %}
                        {% assign heading_classes = 'swiper-slide-heading' %}
                        {% if block.settings.heading_type_preset == 'custom' %}
                          {% assign heading_classes = heading_classes | append: ' custom-typography' %}
                        {% endif %}
                        
                        {% case block.settings.heading_type_preset %}
                          {% when 'h1' %}
                            <h1 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h1>
                          {% when 'h2' %}
                            <h2 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h2>
                          {% when 'h3' %}
                            <h3 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h3>
                          {% when 'h4' %}
                            <h4 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h4>
                          {% when 'h5' %}
                            <h5 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h5>
                          {% when 'h6' %}
                            <h6 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h6>
                          {% else %}
                            <div class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                 {% if block.settings.heading_type_preset == 'custom' %}
                                   style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                 {% else %}
                                   style="color: {{ block.settings.slide_heading_color }} !important;"
                                 {% endif %}>
                              {{ block.settings.heading }}
                            </div>
                        {% endcase %}
                      {% endif %}
                      
                      {% if block.settings.description != blank %}
                        {% assign description_classes = 'swiper-slide-description' %}
                        {% if block.settings.description_type_preset == 'custom' %}
                          {% assign description_classes = description_classes | append: ' custom-typography' %}
                        {% endif %}
                        
                        {% case block.settings.description_type_preset %}
                          {% when 'h1' %}
                            <h1 class="{{ description_classes }}"
                                {% if block.settings.description_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.description_font }}; --font-size: {{ block.settings.description_font_size }}; --line-height: {{ block.settings.description_line_height }}; --letter-spacing: {{ block.settings.description_letter_spacing }}; --text-transform: {{ block.settings.description_case }}; --text-wrap: {{ block.settings.description_wrap }}; --color: {{ block.settings.slide_description_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_description_color }} !important;"
                                {% endif %}>
                              {{ block.settings.description }}
                            </h1>
                          {% when 'h2' %}
                            <h2 class="{{ description_classes }}"
                                {% if block.settings.description_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.description_font }}; --font-size: {{ block.settings.description_font_size }}; --line-height: {{ block.settings.description_line_height }}; --letter-spacing: {{ block.settings.description_letter_spacing }}; --text-transform: {{ block.settings.description_case }}; --text-wrap: {{ block.settings.description_wrap }}; --color: {{ block.settings.slide_description_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_description_color }} !important;"
                                {% endif %}>
                              {{ block.settings.description }}
                            </h2>
                          {% when 'h3' %}
                            <h3 class="{{ description_classes }}"
                                {% if block.settings.description_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.description_font }}; --font-size: {{ block.settings.description_font_size }}; --line-height: {{ block.settings.description_line_height }}; --letter-spacing: {{ block.settings.description_letter_spacing }}; --text-transform: {{ block.settings.description_case }}; --text-wrap: {{ block.settings.description_wrap }}; --color: {{ block.settings.slide_description_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_description_color }} !important;"
                                {% endif %}>
                              {{ block.settings.description }}
                            </h3>
                          {% when 'h4' %}
                            <h4 class="{{ description_classes }}"
                                {% if block.settings.description_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.description_font }}; --font-size: {{ block.settings.description_font_size }}; --line-height: {{ block.settings.description_line_height }}; --letter-spacing: {{ block.settings.description_letter_spacing }}; --text-transform: {{ block.settings.description_case }}; --text-wrap: {{ block.settings.description_wrap }}; --color: {{ block.settings.slide_description_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_description_color }} !important;"
                                {% endif %}>
                              {{ block.settings.description }}
                            </h4>
                          {% when 'h5' %}
                            <h5 class="{{ description_classes }}"
                                {% if block.settings.description_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.description_font }}; --font-size: {{ block.settings.description_font_size }}; --line-height: {{ block.settings.description_line_height }}; --letter-spacing: {{ block.settings.description_letter_spacing }}; --text-transform: {{ block.settings.description_case }}; --text-wrap: {{ block.settings.description_wrap }}; --color: {{ block.settings.slide_description_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_description_color }} !important;"
                                {% endif %}>
                              {{ block.settings.description }}
                            </h5>
                          {% when 'h6' %}
                            <h6 class="{{ description_classes }}"
                                {% if block.settings.description_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.description_font }}; --font-size: {{ block.settings.description_font_size }}; --line-height: {{ block.settings.description_line_height }}; --letter-spacing: {{ block.settings.description_letter_spacing }}; --text-transform: {{ block.settings.description_case }}; --text-wrap: {{ block.settings.description_wrap }}; --color: {{ block.settings.slide_description_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_description_color }} !important;"
                                {% endif %}>
                              {{ block.settings.description }}
                            </h6>
                          {% else %}
                            <div class="{{ description_classes }}"
                                 {% if block.settings.description_type_preset == 'custom' %}
                                   style="--font-family: {{ block.settings.description_font }}; --font-size: {{ block.settings.description_font_size }}; --line-height: {{ block.settings.description_line_height }}; --letter-spacing: {{ block.settings.description_letter_spacing }}; --text-transform: {{ block.settings.description_case }}; --text-wrap: {{ block.settings.description_wrap }}; --color: {{ block.settings.slide_description_color }};"
                                 {% else %}
                                   style="color: {{ block.settings.slide_description_color }} !important;"
                                 {% endif %}>
                              {{ block.settings.description }}
                            </div>
                        {% endcase %}
                      {% endif %}
                      
                      {% if block.settings.button_label != blank %}
                        <div class="swiper-slide-button">
                          {% if block.settings.button_link != blank %}
                          <a href="{{ block.settings.button_link }}" class="button" style="background-color: {{ block.settings.button_background_color }}; color: {{ block.settings.button_text_color }}; border-color: {{ block.settings.button_border_color }}; border-width: {{ block.settings.button_border_width }}px; border-style: {{ block.settings.button_border_style }}; border-radius: {{ block.settings.button_border_radius }}px;">
                              {{ block.settings.button_label }}
                            </a>
                          {% else %}
                            <div class="button" style="background-color: {{ block.settings.button_background_color }}; color: {{ block.settings.button_text_color }}; border-color: {{ block.settings.button_border_color }}; border-width: {{ block.settings.button_border_width }}px; border-style: {{ block.settings.button_border_style }}; border-radius: {{ block.settings.button_border_radius }}px;">
                              {{ block.settings.button_label }}
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                      
                    </div>
                  </div>
                  
                  {% if block.settings.caption != blank %}
                    <div class="swiper-slide-caption">
                      <p>{{ block.settings.caption }}</p>
                    </div>
                  {% endif %}
                </div>

              {% when 'video' %}
                <div class="swiper-slide-video">
                  {% if block.settings.shopify_video != blank %}
                    {% liquid
                      assign video = block.settings.shopify_video
                      assign video_height = video.preview_image.width | divided_by: video.preview_image.aspect_ratio | round
                      assign video_media_width_desktop = '100vw'
                      assign video_media_width_mobile = '100vw'
                      assign video_sizes = '(min-width: 1920px) 1920px, (min-width: 1200px) 1200px, (min-width: 750px) ' | append: video_media_width_desktop | append: ', ' | append: video_media_width_mobile
                      assign video_widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                    %}
                    
                    <!-- Desktop Video -->
                    <div class="swiper-slide-video-desktop{% if block.settings.mobile_video == blank %} swiper-slide-video-fallback{% endif %}">
                      {% if video.preview_image %}
                        {{
                          video.preview_image
                          | image_url: width: 3840
                          | image_tag: 
                            height: video_height,
                            loading: 'lazy',
                            alt: video.alt,
                            class: 'swiper-slide-video-poster',
                            style: 'object-fit: cover; width: 100%; height: 100%;',
                            sizes: video_sizes,
                            widths: video_widths
                        }}
                      {% endif %}
                      
                      {% if block.settings.autoplay_video %}
                        {{
                          video
                          | video_tag: 
                            poster: nil, 
                            autoplay: true, 
                            loop: block.settings.loop_video, 
                            controls: true, 
                            muted: block.settings.muted,
                            playsinline: true,
                            class: 'swiper-slide-video-element'
                        }}
                      {% else %}
                        {{
                          video
                          | video_tag: 
                            poster: nil, 
                            autoplay: false, 
                            loop: block.settings.loop_video, 
                            controls: true, 
                            muted: block.settings.muted,
                            playsinline: true,
                            class: 'swiper-slide-video-element'
                        }}
                      {% endif %}
                    </div>
                    
                    <!-- Mobile Video -->
                    {% if block.settings.mobile_video != blank %}
                      {% liquid
                        assign mobile_video = block.settings.mobile_video
                        assign mobile_video_height = mobile_video.preview_image.width | divided_by: mobile_video.preview_image.aspect_ratio | round
                      %}
                      <div class="swiper-slide-video-mobile">
                        {% if mobile_video.preview_image %}
                          {{
                            mobile_video.preview_image
                            | image_url: width: 3840
                            | image_tag: 
                              height: mobile_video_height,
                              loading: 'lazy',
                              alt: mobile_video.alt,
                              class: 'swiper-slide-video-poster',
                              style: 'object-fit: cover; width: 100%; height: 100%;',
                              sizes: video_sizes,
                              widths: video_widths
                          }}
                        {% endif %}
                        
                        {% if block.settings.autoplay_video %}
                          {{
                            mobile_video
                            | video_tag: 
                              poster: nil, 
                              autoplay: true, 
                              loop: block.settings.loop_video, 
                              controls: true, 
                              muted: block.settings.muted,
                              playsinline: true,
                              class: 'swiper-slide-video-element'
                          }}
                        {% else %}
                          {{
                            mobile_video
                            | video_tag: 
                              poster: nil, 
                              autoplay: false, 
                              loop: block.settings.loop_video, 
                              controls: true, 
                              muted: block.settings.muted,
                              playsinline: true,
                              class: 'swiper-slide-video-element'
                          }}
                        {% endif %}
                      </div>
                    {% endif %}
                    
                    <!-- Video Overlay -->
                    {% if block.settings.video_overlay_opacity > 0 %}
                      <div class="swiper-slide-video-overlay" style="opacity: {{ block.settings.video_overlay_opacity | divided_by: 100.0 }};"></div>
                    {% endif %}
                    
                  {% else %}
                    <div class="swiper-slide-placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                  
                  <!-- Content Overlay -->
                  <div class="swiper-slide-content-overlay swiper-slide-content-position-{{ block.settings.desktop_content_position }} swiper-slide-content-alignment-{{ block.settings.content_alignment }} swiper-slide-mobile-position-{{ block.settings.mobile_content_position }} swiper-slide-mobile-alignment-{{ block.settings.mobile_content_alignment }}">
                    {% liquid
                      assign bg_color = block.settings.content_background_color
                      assign bg_opacity = block.settings.content_background_opacity | divided_by: 100.0
                      assign bg_rgba = bg_color | color_modify: 'alpha', bg_opacity
                      assign backdrop_class = ''
                      assign backdrop_max_width_style = ''
                      if block.settings.enable_backdrop_filter
                        assign backdrop_class = 'swiper-slide-content-backdrop'
                      endif
                      if block.settings.backdrop_max_width != blank
                        assign backdrop_max_width_style = 'max-width: ' | append: block.settings.backdrop_max_width | append: 'px;'
                      endif
                      assign animation_class = 'swiper-slide-animate-' | append: block.settings.content_animation
                      assign animation_duration = block.settings.animation_duration | append: 's'
                      assign animation_delay = block.settings.animation_delay | append: 's'
                    %}
                    <div class="swiper-slide-content-inner {{ backdrop_class }} {{ animation_class }}" style="color: {{ block.settings.text_color }}; background-color: {{ bg_rgba }}; {{ backdrop_max_width_style }} --animation-duration: {{ animation_duration }}; --animation-delay: {{ animation_delay }}; --underline-color: {{ block.settings.underline_color }};">
                      
                      {% if block.settings.highlight_text != blank %}
                        <div class="swiper-slide-highlight-text" style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.slide_highlight_text_color }} !important;">
                          {% if block.settings.icon != 'unset' %}
                            <span class="swiper-slide-icon swiper-slide-icon-{{ block.settings.icon }}" style="color: {{ block.settings.icon_color }};"></span>
                          {% endif %}
                          {{ block.settings.highlight_text }}
                        </div>
                      {% endif %}
                      
                      {% if block.settings.subheading != blank %}
                        <div class="swiper-slide-subheading" style="color: {{ block.settings.slide_subheading_color }} !important;">{{ block.settings.subheading }}</div>
                      {% endif %}
                      
                      {% if block.settings.heading != blank %}
                        {% assign heading_classes = 'swiper-slide-heading' %}
                        {% if block.settings.heading_type_preset == 'custom' %}
                          {% assign heading_classes = heading_classes | append: ' custom-typography' %}
                        {% endif %}
                        
                        {% case block.settings.heading_type_preset %}
                          {% when 'h1' %}
                            <h1 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h1>
                          {% when 'h2' %}
                            <h2 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h2>
                          {% when 'h3' %}
                            <h3 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h3>
                          {% when 'h4' %}
                            <h4 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h4>
                          {% when 'h5' %}
                            <h5 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h5>
                          {% when 'h6' %}
                            <h6 class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                {% if block.settings.heading_type_preset == 'custom' %}
                                  style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                {% else %}
                                  style="color: {{ block.settings.slide_heading_color }} !important;"
                                {% endif %}>
                              {{ block.settings.heading }}
                            </h6>
                          {% else %}
                            <div class="{{ heading_classes }}{% if block.settings.enable_heading_underline_animation %} swiper-slide-heading-animated{% endif %}"
                                 {% if block.settings.heading_type_preset == 'custom' %}
                                   style="--font-family: {{ block.settings.heading_font }}; --font-size: {{ block.settings.heading_font_size }}; --line-height: {{ block.settings.heading_line_height }}; --letter-spacing: {{ block.settings.heading_letter_spacing }}; --text-transform: {{ block.settings.heading_case }}; --text-wrap: {{ block.settings.heading_wrap }}; --color: {{ block.settings.slide_heading_color }};"
                                 {% else %}
                                   style="color: {{ block.settings.slide_heading_color }} !important;"
                                 {% endif %}>
                              {{ block.settings.heading }}
                            </div>
                        {% endcase %}
                      {% endif %}
                      
                      {% if block.settings.description != blank %}
                        {% assign description_classes = 'swiper-slide-description' %}
                        {% if block.settings.description_type_preset == 'custom' %}
                          {% assign description_classes = description_classes | append: ' custom-typography' %}
                        {% endif %}
                        
                        {% case block.settings.description_type_preset %}
                          {% when 'h1' %}
                            <h1 class="{{ description_classes }}"
                                {% if block.settings.description_type_preset == 'custom' %}
