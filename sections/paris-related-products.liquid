{%- if section.settings.show_section -%}
{%- assign limit = section.settings.products_to_show | default: 4 -%}

<section
  class="paris-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="paris-rp-title-{{ section.id }}"
>
  <div class="paris-related-products">

    <div class="paris-section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="paris-section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="paris-section-header__title" id="paris-rp-title-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
    </div>

    <div class="paris-related-products__grid">
      {%- assign rp_collection = section.settings.collection -%}

      {%- if rp_collection != blank -%}
        {%- for rp_product in rp_collection.products limit: limit -%}
          {%- unless rp_product.id == product.id -%}
            {%- assign card_product = rp_product -%}
            {%- assign show_vendor = false -%}
            {% render 'paris-product-card', card_product: card_product, show_vendor: show_vendor %}
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Fallback: use Shopify's built-in product recommendations
          These are populated via the Recommendations API
        {%- endcomment -%}
        <div
          id="paris-recommendations-{{ section.id }}"
          data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
        >
          {%- if recommendations.performed? and recommendations.products_count > 0 -%}
            {%- for rec_product in recommendations.products -%}
              {%- assign card_product = rec_product -%}
              {%- assign show_vendor = false -%}
              {% render 'paris-product-card', card_product: card_product, show_vendor: show_vendor %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              {% render 'paris-product-card' %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{%- comment -%} Load recommendations via fetch if no collection set {%- endcomment -%}
{%- if section.settings.collection == blank -%}
<script>
  (function() {
    var container = document.getElementById('paris-recommendations-{{ section.id }}');
    if (!container) return;
    var url = container.getAttribute('data-url');
    if (!url) return;
    fetch(url)
      .then(function(r) { return r.text(); })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var inner = doc.getElementById('paris-recommendations-{{ section.id }}');
        if (inner) container.innerHTML = inner.innerHTML;
      })
      .catch(function() {});
  })();
</script>
{%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "Produits similaires",
  "tag": "div",
  "class": "paris-section-wrap",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Afficher la section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Vous aimerez aussi"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Pièces similaires"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection source (optionnel — sinon recommandations automatiques)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond de section",
      "default": "#f9f6f1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge intérieure haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge intérieure bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Produits similaires"
    }
  ]
}
{% endschema %}
