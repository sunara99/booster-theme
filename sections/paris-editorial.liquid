{%- if section.settings.show_section -%}
<section
  class="paris-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="paris-ed-title-{{ section.id }}"
>
  <div class="paris-editorial">
    <div class="paris-editorial__grid{% if section.settings.image_position == 'right' %} paris-editorial__grid--reversed{% endif %}">

      {%- comment -%} Media {%- endcomment -%}
      <div class="paris-editorial__media">
        {%- if section.settings.image != blank -%}
          {%- assign editorial_img_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '500, 700, 900',
              sizes: '(max-width: 768px) 100vw, 50vw',
              alt: editorial_img_alt
          }}
        {%- else -%}
          <div style="background-color: {{ section.settings.placeholder_color }}; width: 100%; height: 100%;"></div>
        {%- endif -%}
      </div>

      {%- comment -%} Content {%- endcomment -%}
      <div class="paris-editorial__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="paris-editorial__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="paris-editorial__heading" id="paris-ed-title-{{ section.id }}" style="color: {{ section.settings.text_color }};">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="paris-editorial__text" style="color: {{ section.settings.body_color }};">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- comment -%} Feature blocks {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <ul style="list-style: none; padding: 0; margin: 0 0 32px;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <li style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px;" {{ block.shopify_attributes }}>
                  <span aria-hidden="true" style="color: {{ section.settings.eyebrow_color }}; font-size: 16px; line-height: 1.5; flex-shrink: 0;">—</span>
                  <div>
                    {%- if block.settings.title != blank -%}
                      <strong style="display: block; font-family: var(--pf-font-sans); font-size: 13px; color: {{ section.settings.text_color }}; margin-bottom: 2px;">{{ block.settings.title }}</strong>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <span style="font-family: var(--pf-font-sans); font-size: 13px; color: {{ section.settings.body_color }}; line-height: 1.7;">{{ block.settings.text }}</span>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="paris-btn paris-btn--outline"
            style="color: {{ section.settings.button_color }}; border-color: {{ section.settings.button_color }};"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Section éditoriale",
  "tag": "div",
  "class": "paris-section-wrap",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Afficher la section",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Couleur placeholder",
      "default": "#f0ebe3"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image",
      "options": [
        { "value": "left",  "label": "Gauche" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Textes"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Notre engagement"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Des pièces pensées pour vous"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Chaque création naît d'une attention particulière portée aux matières, aux coupes et aux détails. Nos collections sont conçues pour accompagner votre quotidien avec élégance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton — texte",
      "default": "Découvrir"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Bouton — lien"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond de section",
      "default": "#f9f6f1"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Couleur surtitre",
      "default": "#b5a595"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur titre",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Couleur corps de texte",
      "default": "#6b6b6b"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Couleur bouton",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge intérieure haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge intérieure bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Argument",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Matières sélectionnées"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Lin, soie, coton biologique — des fibres choisies avec soin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Section éditoriale",
      "blocks": [
        { "type": "feature", "settings": { "title": "Matières naturelles", "text": "Lin, soie et coton biologique sélectionnés avec soin." } },
        { "type": "feature", "settings": { "title": "Coupe flatteuse", "text": "Des silhouettes pensées pour toutes les morphologies." } },
        { "type": "feature", "settings": { "title": "Fabrication responsable", "text": "Produit en Europe, dans des ateliers certifiés." } }
      ]
    }
  ]
}
{% endschema %}
