{% if request.design_mode %}
  <script>
    (function() {
      function openEmailPopupInEditor(sectionElement) {
        if (!sectionElement) return;

        var popup = sectionElement.querySelector
          ? sectionElement.querySelector('.email-popup[data-preview-in-editor="true"]')
          : null;
        if (!popup) return;

        var dialogComponent = popup.querySelector('dialog-component');
        if (dialogComponent && typeof dialogComponent.showDialog === 'function') {
          requestAnimationFrame(function() {
            dialogComponent.showDialog();
          });
        }
      }

      function closeEmailPopup() {
        var popup = document.querySelector('.email-popup[data-preview-in-editor="true"]');
        if (!popup) return;

        var dialogComponent = popup.querySelector('dialog-component');
        var dialog = popup.querySelector('dialog');
        if (dialogComponent && typeof dialogComponent.closeDialog === 'function' && dialog && dialog.hasAttribute('open')) {
          dialogComponent.closeDialog();
        }
      }

      function handleSectionSelect(event) {
        var section = event.target;
        if (section && section.querySelector) {
          var hasEmailPopup = section.querySelector('.email-popup[data-preview-in-editor="true"]');
          if (hasEmailPopup) {
            openEmailPopupInEditor(section);
          } else {
            closeEmailPopup();
          }
        }
      }

      function handleSectionDeselect(event) {
        var section = event.target;
        if (section && section.querySelector && section.querySelector('.email-popup[data-preview-in-editor="true"]')) {
          closeEmailPopup();
        }
      }

      document.addEventListener('shopify:section:select', handleSectionSelect);
      document.addEventListener('shopify:section:deselect', handleSectionDeselect);
    })();
  </script>
{% endif %}
