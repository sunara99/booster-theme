        "review_XjRcrH": {
          "type": "review",
          "settings": {
            "selected_product": "",
            "star_rating": 5,
            "name_text": "Sophia Nguyen – Toronto, Canada",
            "country_code": "CA",
            "show_country_flag": true,
            "date_text": "Jan 2026",
            "review_head": "Improved Recovery and Better Sleep",
            "review_text": "As someone who trains four to five times a week, recovery has always been a challenge for me. Since starting this supplement, I’ve noticed significantly less soreness and a deeper, more restful sleep at night. I wake up feeling refreshed instead of groggy, which has been a huge improvement. I appreciate that the ingredients are clean and clearly listed without unnecessary fillers. Highly recommended for anyone who wants to support their fitness goals naturally.",
            "like_size": 17,
            "dislike_size": 0,
            "feature_font_size": 16
          }
        },
        "review_yP8iPJ": {
