          "settings": {
            "selected_product": "",
            "star_rating": 5,
            "name_text": "Isabella Santos – Madrid, Spain",
            "country_code": "ES",
            "show_country_flag": true,
            "date_text": "March 2026",
            "review_head": "Great for Digestion and Gut Health",
            "review_text": "I bought this after struggling with bloating and slow digestion for months. Within the first week, I felt lighter and more regular, and my stomach discomfort almost completely disappeared. I’ve tried many gut-health products before, but this is the only one that actually gave me noticeable results. The capsules are easy to take and don’t have any weird aftertaste. It’s a bit pricier than other brands, but honestly, it’s worth every euro for how much better I feel.",
            "like_size": 0,
            "dislike_size": 0,
            "feature_font_size": 16
          }
        },
        "review_YBMpMW": {
          "type": "review",
          "settings": {
            "selected_product": "",
