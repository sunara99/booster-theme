        </div>
      </div>
      {% endif %}
      {% if tier3_visible %}
      <div class="free-shipping-progress__tier{% if tier3_qualified %} free-shipping-progress__tier--qualified{% endif %}">
        <div class="free-shipping-progress__tier-bar">
          <div class="free-shipping-progress__tier-fill" style="width: {{ tier3_progress }}%"></div>
