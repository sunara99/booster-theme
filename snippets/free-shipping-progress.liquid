        </div>
      </div>
      {% endif %}
    </div>
  {% else %}
    <div class="free-shipping-progress__bar">
      <div 
        class="free-shipping-progress__fill" 
        style="width: {{ progress_percentage }}%"
        data-progress="{{ progress_percentage }}"
      ></div>
