{%- liquid
  assign _money_fmt = shop.money_format | strip
  if _money_fmt contains '{{amount}}'
    assign _fmt_parts = _money_fmt | split: '{{amount}}'
    assign theme_currency_prefix = _fmt_parts[0] | strip_html | strip
    assign theme_currency_suffix = _fmt_parts[1] | strip_html | strip
    if theme_currency_prefix != blank
      assign theme_currency_prefix = cart.currency.symbol
    elsif theme_currency_suffix != blank
      assign theme_currency_suffix = cart.currency.symbol
    endif
  else
    assign theme_currency_prefix = cart.currency.symbol | append: ''
    assign theme_currency_suffix = ''
  endif

  assign _ps_enabled = settings.prices_superscript_enabled
  unless _ps_enabled == true or _ps_enabled == false
    assign _ps_enabled = true
  endunless
  assign _ps_product_page = settings.prices_superscript_product_pages
  unless _ps_product_page == true or _ps_product_page == false
    assign _ps_product_page = true
  endunless
  assign _ps_product_cards = settings.prices_superscript_product_cards
  unless _ps_product_cards == true or _ps_product_cards == false
    assign _ps_product_cards = true
  endunless
  assign _ps_cart = settings.prices_superscript_cart
  unless _ps_cart == true or _ps_cart == false
    assign _ps_cart = true
  endunless
  assign _ps_cart_summary = settings.prices_superscript_cart_summary
  unless _ps_cart_summary == true or _ps_cart_summary == false
    assign _ps_cart_summary = true
  endunless
  assign _ps_quick_order = settings.prices_superscript_quick_order
  unless _ps_quick_order == true or _ps_quick_order == false
    assign _ps_quick_order = true
  endunless
  assign _ps_quantity_breaks = settings.prices_superscript_quantity_breaks
  unless _ps_quantity_breaks == true or _ps_quantity_breaks == false
    assign _ps_quantity_breaks = true
  endunless
  assign _ps_bundles = settings.prices_superscript_bundles
  unless _ps_bundles == true or _ps_bundles == false
    assign _ps_bundles = true
  endunless
  assign _ps_upsells = settings.prices_superscript_upsells
  unless _ps_upsells == true or _ps_upsells == false
    assign _ps_upsells = true
  endunless
-%}
<script>
  window.__te_d = {{ shop.permanent_domain | json }};
  const Theme = {
    translations: {
      placeholder_image: `{{ 'content.placeholder_image' | t }}`,
      added: `{{ 'actions.added' | t }}`,
      recipient_form_fields_visible: `{{ 'content.recipient_form_fields_visible' | t }}`,
      recipient_form_fields_hidden: `{{ 'content.recipient_form_fields_hidden' | t }}`,
      recipient_form_error: `{{ 'content.recipient_form_error' | t }}`,
      items_added_to_cart_one: `{{ 'content.items_added_to_cart.one' | t }}`,
      items_added_to_cart_other: `{{ 'content.items_added_to_cart.other' | t }}`,
      unlisted_heading: `{{ 'listing.unlisted_heading' | t }}`,
      unlisted_message: `{{ 'listing.unlisted_message' | t }}`,
      l1: `{{ 'listing.b1' | t }}`,
      unlisted_already_msg: `{{ 'listing.already_buy_message' | t }}`,
      l2: `{{ 'listing.b2' | t }}`,
      store_url_instruction: `{{ 'listing.store_url_instruction' | t }}`,
      copy_title: `{{ 'listing.copy_title' | t }}`,
    },
    routes: {
      cart_add_url: '{{ routes.cart_add_url | append: '.js' }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url | append: ".js" }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}',
      search_url: '{{ routes.search_url }}',
    },
    cart: {
      type: {{ settings.cart_type | default: 'page' | json }},
      auto_open_page: {{ settings.auto_open_cart_page | default: false | json }},
      auto_open_drawer: {{ settings.auto_open_cart_drawer | default: false | json }},
    },
    template: { name: '{{ template }}' },
    moneyFormat: {{ shop.money_format | json }},
    currency: {{ cart.currency.iso_code | json }},
    currencySymbol: {{ cart.currency.symbol | json }},
    currencyPrefix: {{ theme_currency_prefix | json }},
    currencySuffix: {{ theme_currency_suffix | json }},
    priceSplit: {
      enabled: {{ _ps_enabled | json }},
      contexts: {
        product_page: {{ _ps_product_page | json }},
        product_cards: {{ _ps_product_cards | json }},
        cart: {{ _ps_cart | json }},
        cart_summary: {{ _ps_cart_summary | json }},
        quick_order: {{ _ps_quick_order | json }},
        quantity_breaks: {{ _ps_quantity_breaks | json }},
        bundles: {{ _ps_bundles | json }},
        upsells: {{ _ps_upsells | json }},
      },
    },
  };
  window.Theme = Theme;
  (function () {
    function themePlainMoney(cents) {
      var c = Number(cents);
      var amount = c / 100;
      if (Theme.moneyFormat) {
        var formatted = new Intl.NumberFormat(document.documentElement.lang || 'en', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        }).format(amount);
        var rounded = String(Math.round(amount));
        var withComma = amount.toFixed(2).replace('.', ',');
        var amountText = formatted;
        if (/\{\{\s*amount_no_decimals/.test(Theme.moneyFormat)) {
          amountText = rounded;
        } else if (/\{\{\s*amount_with_comma_separator/.test(Theme.moneyFormat)) {
          amountText = withComma;
        } else if (/\{\{\s*amount_with_apostrophe_separator/.test(Theme.moneyFormat)) {
          amountText = formatted.replace('.', "'");
        }
        if (Theme.currencySymbol && (Theme.currencyPrefix || Theme.currencySuffix)) {
          return ((Theme.currencyPrefix || '') + amountText + (Theme.currencySuffix || '')).trim();
        }
        var result = Theme.moneyFormat
          .replace(/\{\{\s*amount\s*\}\}/g, formatted)
          .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, rounded)
          .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, withComma)
          .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, rounded)
          .replace(/\{\{\s*amount_with_space_separator\s*\}\}/g, withComma)
          .replace(/\{\{\s*amount_with_apostrophe_separator\s*\}\}/g, formatted.replace('.', "'"))
          .replace(/\{\{\s*amount_no_decimals_with_space_separator\s*\}\}/g, rounded)
          .replace(/\{\{\s*amount_with_period_and_space_separator\s*\}\}/g, formatted);
        return result.replace(/<[^>]+>/g, '').trim();
      }
      return new Intl.NumberFormat(document.documentElement.lang || 'en', {
        style: 'currency',
        currency: Theme.currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(amount);
    }
    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    function formatWholeAmount(cents) {
      var c = Number(cents);
      var amount = Math.trunc(Math.abs(c) / 100);
      var formatted = new Intl.NumberFormat(document.documentElement.lang || 'en', {
        maximumFractionDigits: 0,
      }).format(amount);
      return c < 0 ? '-' + formatted : formatted;
    }
    Theme.shouldUsePriceSplit = function (context) {
      var p = Theme.priceSplit;
      var ctx = context || 'product_page';
      if (!p || !p.enabled) return false;
      var v = p.contexts && p.contexts[ctx];
      return v === true;
    };
    Theme.formatPriceSplitHTML = function (cents, useCurrency, context) {
      var c = Number(cents);
      var ctx = context || 'product_page';
      if (!Theme.shouldUsePriceSplit(ctx)) {
        return '<span class="money">' + escapeHtml(themePlainMoney(c)) + '</span>';
      }
      var n = Math.abs(c);
      var whole = formatWholeAmount(c);
      var f = String(n % 100).padStart(2, '0');
      var plain = themePlainMoney(c);
      var pre = Theme.currencyPrefix != null ? Theme.currencyPrefix : '';
      var suf = Theme.currencySuffix != null ? Theme.currencySuffix : '';
      var code =
        useCurrency && Theme.currency
          ? ' <span class="price-split__code">' + escapeHtml(Theme.currency) + '</span>'
          : '';
      return (
        '<span class="price-split">' +
        '<span class="visually-hidden">' +
        escapeHtml(plain) +
        '</span>' +
        '<span class="price-split__visual" aria-hidden="true">' +
        escapeHtml(pre) +
        '<span class="price-split__integer">' +
        escapeHtml(whole) +
        '</span><sup class="price-split__fraction">' +
        f +
        '</sup>' +
        escapeHtml(suf) +
        code +
        '</span></span>'
      );
    };
  })();
</script>

