{%- doc -%}
  Sets inline CSS variables for typography styles, including color, font size, weight, family, line height, and letter spacing.
  Intended for use on the style attribute of an element.

  @param {object} settings - The block or section settings object containing typography values
  @param {string} [type] - The type of text element to inherit styles from, options: display, heading, body
  @param {string} [preset] - The type preset from the global settings.type_preset

  @example
  <div style="{% render 'typography-style', settings: section.settings %}">
    ...
  </div>
{%- enddoc -%}

{% assign preset = preset | default: settings.type_preset %}

{%- capture variables -%}
  {%- if preset != 'rte' -%}
    {%- if settings.color_mode == 'default' and settings.color != "" -%}
      --color: {{ settings.color }};
    {%- elsif settings.color_mode == 'custom' and settings.custom_color_style == 'solid' and settings.custom_text_color != blank -%}
      --color: {{ settings.custom_text_color }};
    {%- elsif settings.color_mode == 'custom' and settings.custom_color_style == 'gradient' -%}
      --text-gradient: linear-gradient({{ settings.custom_gradient_direction | default: 'to right' }}, {{ settings.custom_gradient_color_start | default: '#000000' }}, {{ settings.custom_gradient_color_end | default: '#666666' }});
    {%- endif -%}
    {%- if settings.color_mode == 'custom' and settings.custom_color_bold != blank -%}
      --color-bold: {{ settings.custom_color_bold }};
    {%- endif -%}
    {%- if settings.color_mode == 'custom' and settings.custom_color_italic != blank -%}
      --color-italic: {{ settings.custom_color_italic }};
    {%- endif -%}
    {%- if settings.color_mode == 'custom' and settings.custom_color_underline != blank -%}
      --color-underline: {{ settings.custom_color_underline }};
    {%- endif -%}
    {%- if settings.color_mode == 'custom' and settings.custom_color_background_bold != blank -%}
      {%- assign bg_bold_a = settings.custom_color_background_bold | color_extract: 'alpha' -%}
      {%- if bg_bold_a > 0 -%}
        --text-bg-bold: {{ settings.custom_color_background_bold }};
      {%- endif -%}
    {%- endif -%}
    {%- if settings.color_mode == 'custom' and settings.custom_color_background_italic != blank -%}
      {%- assign bg_italic_a = settings.custom_color_background_italic | color_extract: 'alpha' -%}
      {%- if bg_italic_a > 0 -%}
        --text-bg-italic: {{ settings.custom_color_background_italic }};
      {%- endif -%}
    {%- endif -%}
    {%- if settings.color_mode == 'custom' and settings.custom_color_background_underline != blank -%}
      {%- assign bg_under_a = settings.custom_color_background_underline | color_extract: 'alpha' -%}
      {%- if bg_under_a > 0 -%}
        --text-bg-underline: {{ settings.custom_color_background_underline }};
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if preset == 'custom' -%}
    {% liquid
      unless type
        comment
          When choosing to customize the font, picking a specific font size
          determines the type of text block.
        endcomment
        if settings.font_size != ''
          assign font_size_value = settings.font_size | split: 'rem' | first | times: 1.0

          if font_size_value > 4.5
            assign type = 'display'
          elsif font_size_value > 3.5
            assign type = 'heading'
          else
            assign type = 'body'
          endif
        endif
      endunless
      if type == blank
        assign type = 'body'
      endif
    %}
    {%- if settings.font_size != blank -%}
      {%- liquid
        assign font_size_rem = settings.font_size | split: 'rem' | first | times: 1.0
        assign fluid_size_cutoff_rem = 3.0

        if font_size_rem >= fluid_size_cutoff_rem
          assign target_viewport = 1400
          assign vw_value = font_size_rem | times: 16 | divided_by: target_viewport | times: 100

          assign scale_factor = font_size_rem | divided_by: fluid_size_cutoff_rem
          assign base_min_rem = 3.0
          assign scaling_bonus_rem = scale_factor | minus: 1 | times: 0.25
          assign dynamic_min_rem = base_min_rem | plus: scaling_bonus_rem
        endif
      -%}
      {%- if font_size_rem >= fluid_size_cutoff_rem -%}
        --font-size: clamp({{ dynamic_min_rem }}rem, {{ vw_value }}vw, {{ settings.font_size }});
      {%- else -%}
        --font-size: {{ settings.font_size }};
      {%- endif -%}
    {%- endif -%}
    {%- if settings.font == 'custom_font' -%}
      {%- if settings.custom_typography_font != blank -%}
        {%- if settings.weight != blank -%}
          --font-weight: {{ settings.weight }};
        {%- else -%}
          --font-weight: {{ settings.custom_typography_font.weight }};
        {%- endif -%}
        --font-family: {% render 'font-family-value', font: settings.custom_typography_font, in_style_attribute: true %};
      {%- else -%}
        {%- if settings.weight != blank -%}
          --font-weight: {{ settings.weight }};
        {%- else -%}
          --font-weight: var(--font-body--weight);
        {%- endif -%}
        --font-family: var(--font-body--family);
      {%- endif -%}
    {%- else -%}
      {%- if settings.weight != blank -%}
        --font-weight: {{ settings.weight }};
      {% else %}
        --font-weight: {{ settings.font | replace: 'family', 'weight' }};
      {%- endif -%}
      --font-family: {{ settings.font }};
    {%- endif -%}
    --text-transform: {{ settings.case }};
    --text-wrap: {{ settings.wrap | default: 'pretty' }};
    {% if settings.type_preset == 'custom' and settings.font_size == blank %}
      --line-height--display: var(--line-height--display-{{ settings.line_height }});
      --line-height--heading: var(--line-height--heading-{{ settings.line_height }});
      --line-height--body: var(--line-height--body-{{ settings.line_height }});
    {% else %}
      --line-height: var(--line-height--{{ type }}-{{ settings.line_height }});
    {% endif %}
    --letter-spacing: var(--letter-spacing--{{ type }}-{{ settings.letter_spacing }});
    {%- if settings.enable_bold_typography_font and settings.bold_typography_font != blank -%}
      --font-family-emphasis-bold: {% render 'font-family-value', font: settings.bold_typography_font, in_style_attribute: true %};
      --font-weight-emphasis-bold: {{ settings.bold_typography_font.weight }};
    {%- endif -%}
    {%- if settings.enable_italic_typography_font and settings.italic_typography_font != blank -%}
      --font-family-emphasis-italic: {% render 'font-family-value', font: settings.italic_typography_font, in_style_attribute: true %};
      --font-weight-emphasis-italic: {{ settings.italic_typography_font.weight }};
      --font-style-emphasis-italic: {{ settings.italic_typography_font.style }};
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{{- variables | strip | strip_newlines -}}
